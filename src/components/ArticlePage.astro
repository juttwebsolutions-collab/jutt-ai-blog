---
const { post, relatedPosts = [] } = Astro.props;
---

<article class="article">
  {post.image && <img class="hero-image" src={post.image} alt={post.title} loading="eager" decoding="async" />}
  <div class="article-body">
    <p class="meta">{post.category} · {post.date}</p>
    <h1>{post.title}</h1>
    <p class="intro">{post.description}</p>
    <div class="content">
      <slot />
    </div>
  </div>
  {relatedPosts.length > 0 && (
    <aside class="related">
      <h2>Related articles</h2>
      <ul>
        {relatedPosts.map((item) => (
          <li><a href={`/blog/${item.slug}`}>{item.title}</a></li>
        ))}
      </ul>
    </aside>
  )}
</article>

<style>
  .article {
    display: grid;
    gap: 1.25rem;
  }
  .hero-image {
    width: 100%;
    height: 280px;
    object-fit: cover;
    border-radius: 1rem;
  }
  .article-body {
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--surface);
    padding: 1.5rem;
  }
  .meta {
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 0.4rem;
  }
  h1 { margin: 0 0 0.75rem; font-size: clamp(1.8rem, 3vw, 2.4rem); }
  .intro { color: var(--muted); font-size: 1.02rem; }
  .content :global(h2) { font-size: 1.2rem; margin-top: 1.4rem; margin-bottom: 0.5rem; }
  .content :global(p) { color: var(--muted); }
  .related {
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--surface);
    padding: 1rem 1.25rem;
  }
  .related ul { padding-left: 1rem; margin: 0.5rem 0 0; }
  .related li { margin-bottom: 0.4rem; }
</style>
