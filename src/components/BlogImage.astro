---
import { resolveImagePath } from '../utils/image';

const {
  src,
  alt = 'Article image',
  class: className = '',
  loading = 'lazy',
  decoding = 'async',
  priority = false,
  width = '1200',
  height = '720'
} = Astro.props;

const resolvedSrc = resolveImagePath(src);
const isPriority = priority ? 'eager' : loading;
---

<img
  src={resolvedSrc}
  alt={alt}
  class={className}
  loading={isPriority}
  decoding={decoding}
  width={width}
  height={height}
  sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw"
  onerror={`this.onerror=null;this.src='/images/blog/placeholder.svg';`}
/>