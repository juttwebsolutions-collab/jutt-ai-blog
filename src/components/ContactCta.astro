---
const { eyebrow = 'Let’s talk', title = 'Need a site that actually works for your business?', linkText = 'Discuss Your Project', href = '/contact' } = Astro.props;
---

<section class="cta-section">
  <div class="cta-card">
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h2>{title}</h2>
    </div>
    <a class="button" href={href}>{linkText}</a>
  </div>
</section>

<style>
  .cta-section {
    padding: 4rem 0 0;
  }

  .cta-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    background: linear-gradient(135deg, #0f172a, #1e293b);
    border-radius: 28px;
    padding: 2rem;
    color: white;
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.72rem;
    font-weight: 700;
    color: #cbd5e1;
  }

  h2 {
    margin: 0;
    color: white;
    font-size: clamp(1.7rem, 2vw, 2.5rem);
    line-height: 1.15;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 0.9rem 1.4rem;
    background: white;
    color: #0f172a;
    font-weight: 800;
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    .cta-card {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
