---
import { navItems, servicePages, demoProjects, portfolioProjects, siteConfig } from '../data/site';

const serviceLinks = servicePages.map(({ slug, title }) => ({ href: `/services/${slug}`, label: title }));
const portfolioLinks = portfolioProjects.map(({ title, route }) => ({ href: route, label: title }));
---

<footer class="site-footer">
  <div class="footer-shell">
    <div class="footer-column footer-brand">
      <a class="brand" href="/">
        <span class="brand-mark">J</span>
        <div>
          <strong>{siteConfig.siteName}</strong>
          <p>{siteConfig.baseDescription}</p>
        </div>
      </a>
      <div class="social-links" aria-label="Social links">
        <a href="mailto:hello@yourdomain.com" aria-label="Email Jutt AI">Email</a>
        <a href="/contact" aria-label="Contact Jutt AI">Contact</a>
        <a href="/portfolio" aria-label="View portfolio">Portfolio</a>
      </div>
    </div>

    <div class="footer-column">
      <h3>Services</h3>
      {serviceLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </div>

    <div class="footer-column">
      <h3>Portfolio</h3>
      {portfolioLinks.slice(0, 4).map((link) => <a href={link.href}>{link.label}</a>)}
      <a href="/demos">Website demos</a>
    </div>

    <div class="footer-column footer-contact">
      <h3>Contact</h3>
      <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
      <span>{siteConfig.location}</span>
      <a href="/about">About Jutt AI</a>
      <a href="/privacy">Privacy policy</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #0f172a;
    color: #e2e8f0;
    padding: 3rem 1rem 2.5rem;
    margin-top: 4rem;
  }

  .footer-shell {
    width: min(1180px, calc(100% - 1.5rem));
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.35fr 1fr 1fr 1fr;
    gap: 2rem;
  }

  .footer-column {
    display: grid;
    align-content: start;
    gap: 0.8rem;
  }

  .brand {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.9rem;
    color: white;
  }

  .brand-mark {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 18px;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #0f766e, #2dd4bf);
    color: white;
    font-weight: 800;
  }

  .footer-brand strong {
    display: block;
    font-size: 1.1rem;
    color: white;
  }

  .footer-brand p {
    margin: 0.35rem 0 0;
    color: #cbd5e1;
    max-width: 290px;
    line-height: 1.7;
  }

  .footer-column h3 {
    margin: 0 0 0.4rem;
    color: white;
    font-size: 1rem;
  }

  .footer-column a,
  .footer-column span {
    color: #cbd5e1;
    text-decoration: none;
    line-height: 1.7;
  }

  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.75rem;
  }

  .social-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 90px;
    min-height: 40px;
    border-radius: 999px;
    padding: 0 0.9rem;
    background: rgba(255, 255, 255, 0.06);
    color: white;
    font-weight: 600;
  }

  @media (max-width: 960px) {
    .footer-shell {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .footer-shell {
      grid-template-columns: 1fr;
    }
  }
</style>
