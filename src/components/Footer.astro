---
import { siteConfig } from '../data/site';
import { coreToolIds, tools } from '../data/tools';
import { getCollection } from 'astro:content';

const coreTools = tools.filter((tool) => coreToolIds.includes(tool.id));
const blogEntries = await getCollection('blog');
const blogCategories = [...blogEntries.reduce((counts, entry) => {
  counts.set(entry.data.category, (counts.get(entry.data.category) ?? 0) + 1);
  return counts;
}, new Map<string, number>())]
  .sort(([categoryA, countA], [categoryB, countB]) => countB - countA || categoryA.localeCompare(categoryB))
  .slice(0, 6)
  .map(([category]) => category);
---

<footer class="site-footer">
  <div class="footer-shell">
    <div class="footer-column footer-brand">
      <a class="brand" href="/">
        <span class="brand-mark">J</span>
        <div>
          <strong>{siteConfig.siteName}</strong>
          <p>{siteConfig.baseDescription}</p>
        </div>
      </a>
      <div class="social-links" aria-label="Social links">
        <a href={`mailto:${siteConfig.email}`} aria-label="Email Jutt AI">Email</a>
        <a href="/contact" aria-label="Contact Jutt AI">Contact</a>
        <a href="/#tools" aria-label="Browse all tools">All tools</a>
      </div>
    </div>

    <div class="footer-column">
      <h3>Core tools</h3>
      {coreTools.map((tool) => <a href={`/tools/${tool.id}`}>{tool.title}</a>)}
      <a href="/tools">Browse all tools</a>
    </div>

    <div class="footer-column">
      <h3>Blog categories</h3>
      {blogCategories.map((category) => (
        <a href={`/blog?category=${encodeURIComponent(category)}`}>{category}</a>
      ))}
      <a href="/blog">All articles</a>
    </div>

    <div class="footer-column">
      <h3>Explore</h3>
      <a href="/about">About the platform</a>
      <a href="/services">Services</a>
      <a href="/demos">Demos</a>
      <a href="/contact">Contact</a>
      <a href="/privacy">Privacy policy</a>
    </div>

    <div class="footer-column footer-contact">
      <h3>Jutt AI Tools</h3>
      <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
      <a href={`tel:${siteConfig.phone}`}>Call {siteConfig.phone}</a>
      <a href={`sms:${siteConfig.phone}`}>Text us</a>
      <a href={`https://wa.me/${siteConfig.whatsapp}`} target="_blank" rel="noopener noreferrer">WhatsApp us</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background:
      radial-gradient(ellipse at 8% 0%, rgba(13, 148, 136, 0.2), transparent 32rem),
      linear-gradient(145deg, #0f172a, #111e30);
    color: #e2e8f0;
    padding: 3.5rem 1rem 2.75rem;
    margin-top: 4rem;
    border-top: 1px solid rgba(148, 163, 184, 0.18);
  }

  .footer-shell {
    width: min(1180px, calc(100% - 1.5rem));
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.35fr repeat(2, minmax(0, 1fr)) 1.1fr 1.1fr;
    gap: 2rem;
  }

  .footer-column {
    display: grid;
    align-content: start;
    gap: 0.8rem;
  }

  .footer-column:not(.footer-brand) {
    padding-left: 1rem;
    border-left: 1px solid rgba(148, 163, 184, 0.14);
  }

  .brand {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.9rem;
    color: white;
  }

  .brand-mark {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 18px;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #0f766e, #2dd4bf);
    color: white;
    font-weight: 800;
  }

  .footer-brand strong {
    display: block;
    font-size: 1.1rem;
    color: white;
  }

  .footer-brand p {
    margin: 0.35rem 0 0;
    color: #cbd5e1;
    max-width: 290px;
    line-height: 1.7;
  }

  .footer-column h3 {
    margin: 0 0 0.4rem;
    color: white;
    font-size: 1rem;
    letter-spacing: -0.01em;
  }

  .footer-column a,
  .footer-column span {
    color: #cbd5e1;
    text-decoration: none;
    line-height: 1.7;
  }

  .footer-column a {
    width: fit-content;
    max-width: 100%;
    text-underline-offset: 0.2em;
    transition: color 160ms ease, transform 160ms ease;
  }

  .footer-column a:hover,
  .footer-column a:focus-visible {
    color: #99f6e4;
  }

  .footer-column a:hover {
    transform: translateX(2px);
  }

  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.75rem;
  }

  .social-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 90px;
    min-height: 44px;
    border-radius: 999px;
    padding: 0 0.9rem;
    border: 1px solid rgba(148, 163, 184, 0.16);
    background: rgba(255, 255, 255, 0.055);
    color: white;
    font-weight: 600;
    transition: background-color 160ms ease, border-color 160ms ease, transform 160ms ease;
  }

  .social-links a:hover {
    transform: translateY(-1px);
    border-color: rgba(94, 234, 212, 0.35);
    background: rgba(45, 212, 191, 0.12);
    color: #ccfbf1;
  }

  @media (max-width: 960px) {
    .footer-shell {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .footer-shell {
      grid-template-columns: 1fr;
    }

    .footer-column:not(.footer-brand) {
      padding-top: 1rem;
      padding-left: 0;
      border-top: 1px solid rgba(148, 163, 184, 0.14);
      border-left: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-column a,
    .social-links a {
      transition: none;
    }
  }
</style>
