---
import { siteConfig } from '../data/site';
import { tools } from '../data/tools';
import { getCollection } from 'astro:content';

const coreToolIds = [
  'text-formatter',
  'json-formatter',
  'password-generator',
  'word-counter',
  'base64-encoder-decoder',
  'slug-generator',
];
const coreTools = tools.filter((tool) => coreToolIds.includes(tool.id));
const blogEntries = await getCollection('blog');
const blogCategories = [...blogEntries.reduce((counts, entry) => {
  counts.set(entry.data.category, (counts.get(entry.data.category) ?? 0) + 1);
  return counts;
}, new Map<string, number>())]
  .sort(([categoryA, countA], [categoryB, countB]) => countB - countA || categoryA.localeCompare(categoryB))
  .slice(0, 6)
  .map(([category]) => category);
---

<footer class="site-footer">
  <div class="footer-shell">
    <div class="footer-column footer-brand">
      <a class="brand" href="/">
        <span class="brand-mark">J</span>
        <div>
          <strong>{siteConfig.siteName}</strong>
          <p>{siteConfig.baseDescription}</p>
        </div>
      </a>
      <div class="social-links" aria-label="Social links">
        <a href={`mailto:${siteConfig.email}`} aria-label="Email Jutt AI">Email</a>
        <a href="/contact" aria-label="Contact Jutt AI">Contact</a>
        <a href="/#tools" aria-label="Browse all tools">All tools</a>
      </div>
    </div>

    <div class="footer-column">
      <h3>Core tools</h3>
      {coreTools.map((tool) => <a href={`/tools/${tool.id}`}>{tool.title}</a>)}
      <a href="/#tools">Browse all tools</a>
    </div>

    <div class="footer-column">
      <h3>Blog categories</h3>
      {blogCategories.map((category) => (
        <a href={`/blog?category=${encodeURIComponent(category)}`}>{category}</a>
      ))}
      <a href="/blog">All articles</a>
    </div>

    <div class="footer-column">
      <h3>Explore</h3>
      <a href="/about">About the platform</a>
      <a href="/services">Services</a>
      <a href="/demos">Demos</a>
      <a href="/contact">Contact</a>
      <a href="/privacy">Privacy policy</a>
    </div>

    <div class="footer-column footer-contact">
      <h3>Jutt AI Tools</h3>
      <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
      <a href={`tel:${siteConfig.phone}`}>Call {siteConfig.phone}</a>
      <a href={`sms:${siteConfig.phone}`}>Text us</a>
      <a href={`https://wa.me/${siteConfig.whatsapp}`} target="_blank" rel="noopener noreferrer">WhatsApp us</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #0f172a;
    color: #e2e8f0;
    padding: 3rem 1rem 2.5rem;
    margin-top: 4rem;
  }

  .footer-shell {
    width: min(1180px, calc(100% - 1.5rem));
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.35fr repeat(2, minmax(0, 1fr)) 1.1fr 1.1fr;
    gap: 2rem;
  }

  .footer-column {
    display: grid;
    align-content: start;
    gap: 0.8rem;
  }

  .brand {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.9rem;
    color: white;
  }

  .brand-mark {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 18px;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #0f766e, #2dd4bf);
    color: white;
    font-weight: 800;
  }

  .footer-brand strong {
    display: block;
    font-size: 1.1rem;
    color: white;
  }

  .footer-brand p {
    margin: 0.35rem 0 0;
    color: #cbd5e1;
    max-width: 290px;
    line-height: 1.7;
  }

  .footer-column h3 {
    margin: 0 0 0.4rem;
    color: white;
    font-size: 1rem;
  }

  .footer-column a,
  .footer-column span {
    color: #cbd5e1;
    text-decoration: none;
    line-height: 1.7;
  }

  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.75rem;
  }

  .social-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 90px;
    min-height: 40px;
    border-radius: 999px;
    padding: 0 0.9rem;
    background: rgba(255, 255, 255, 0.06);
    color: white;
    font-weight: 600;
  }

  @media (max-width: 960px) {
    .footer-shell {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .footer-shell {
      grid-template-columns: 1fr;
    }
  }
</style>
