---
const { pathname } = Astro.url;
const links = [
  { href: '/', label: 'Home' },
  { href: '/#featured', label: 'Features' },
  { href: '/blog', label: 'Blogger' },
  { href: '/about', label: 'Typography' },
  { href: '/contact', label: 'Shortcodes' }
];
const isActive = (href: string) => {
  const cleanHref = href.replace(/#.*$/,'');
  return pathname === cleanHref || (cleanHref !== '/' && pathname.startsWith(cleanHref));
};
---

<header class="site-header">
  <div class="header-shell">
    <a class="brand" href="/">
      <span class="brand-mark">JS</span>
      <div class="brand-text">
        <strong>Jutt Ai Blog</strong>
        <span>Tech News, Guides & Fixes</span>
      </div>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-label="Open navigation">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav class="nav-panel" aria-label="Primary navigation">
      <div class="nav-links">
        {links.map((link) => (
          <a href={link.href} class={isActive(link.href) ? 'active' : ''}>{link.label}</a>
        ))}
      </div>
    </nav>

    <button class="search-toggle" type="button" aria-expanded="false" aria-label="Open search">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M10.5 18a7.5 7.5 0 1 1 5.26-2.24l5.24 5.24-1.06 1.06-5.24-5.24A7.47 7.47 0 0 1 10.5 18Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>

  <div class="search-panel" hidden>
    <form class="search-form" role="search">
      <label class="sr-only" for="global-search">Search articles</label>
      <div class="search-field">
        <input id="global-search" type="search" placeholder="Search articles, AI tools, guides..." />
        <button type="button" class="search-close" aria-label="Close search">✕</button>
      </div>
    </form>
  </div>
</header>

<script is:inline>
  (function () {
    const header = document.currentScript?.previousElementSibling;
    if (!header) return;
    const toggle = header.querySelector('.nav-toggle');
    const panel = header.querySelector('.nav-panel');
    const searchToggle = header.querySelector('.search-toggle');
    const searchPanel = header.querySelector('.search-panel');
    const searchClose = header.querySelector('.search-close');

    function closeMenu() {
      header.classList.remove('nav-open');
      toggle?.setAttribute('aria-expanded', 'false');
    }

    function closeSearch() {
      header.classList.remove('search-open');
      searchToggle?.setAttribute('aria-expanded', 'false');
      if (searchPanel) {
        searchPanel.setAttribute('hidden', '');
      }
    }

    toggle?.addEventListener('click', function () {
      const expanded = this.getAttribute('aria-expanded') === 'true';
      if (expanded) {
        closeMenu();
      } else {
        header.classList.add('nav-open');
        this.setAttribute('aria-expanded', 'true');
        closeSearch();
      }
    });

    searchToggle?.addEventListener('click', function () {
      const expanded = this.getAttribute('aria-expanded') === 'true';
      if (expanded) {
        closeSearch();
      } else {
        header.classList.add('search-open');
        this.setAttribute('aria-expanded', 'true');
        if (searchPanel) {
          searchPanel.removeAttribute('hidden');
          const input = searchPanel.querySelector('input');
          input?.focus();
        }
      }
    });

    searchClose?.addEventListener('click', closeSearch);

    document.addEventListener('click', function (event) {
      if (!header.contains(event.target) && header.classList.contains('nav-open')) {
        closeMenu();
      }
    });

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape') {
        closeMenu();
        closeSearch();
      }
    });
  })();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 70;
    border-bottom: 1px solid rgba(226, 232, 240, 0.96);
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(18px);
  }

  .header-shell {
    width: min(1180px, calc(100% - 1.5rem));
    margin: 0 auto;
    padding: 0.9rem 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    color: var(--text-strong);
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 18px;
    background: linear-gradient(135deg, var(--accent), #3b82f6);
    color: white;
    font-weight: 700;
    box-shadow: 0 12px 28px rgba(37, 99, 235, 0.18);
  }

  .brand-text {
    display: grid;
    line-height: 1.1;
  }

  .brand-text strong {
    font-size: 1rem;
  }

  .brand-text span {
    font-size: 0.85rem;
    color: var(--muted);
    letter-spacing: 0.01em;
  }

  .nav-panel {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .nav-links a {
    color: var(--muted);
    font-weight: 600;
    padding: 0.65rem 0.95rem;
    border-radius: 999px;
    transition: color 0.2s ease, background 0.2s ease, transform 0.2s ease;
  }

  .nav-links a:hover,
  .nav-links a.active {
    color: var(--accent-strong);
    background: var(--accent-soft);
    transform: translateY(-1px);
  }

  .nav-toggle,
  .search-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: transparent;
    color: var(--text-strong);
    border: 1px solid rgba(148, 163, 184, 0.35);
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .nav-toggle:hover,
  .search-toggle:hover,
  .nav-toggle:focus-visible,
  .search-toggle:focus-visible {
    background: var(--surface-alt);
    transform: translateY(-1px);
  }

  .nav-toggle span {
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;
    border-radius: 999px;
  }

  .nav-toggle span + span {
    margin-top: 5px;
  }

  .search-panel {
    width: min(1180px, calc(100% - 1.5rem));
    margin: 0 auto;
    padding: 0 0 1rem;
  }

  .search-form {
    width: 100%;
    max-width: 680px;
  }

  .search-field {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.75rem;
    align-items: center;
  }

  .search-field input {
    width: 100%;
    min-height: 50px;
    border-radius: 14px;
    border: 1px solid var(--border);
    padding: 0.95rem 1rem;
    font-size: 0.98rem;
    color: var(--text);
    background: var(--surface);
  }

  .search-field input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.12);
  }

  .search-close {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(148, 163, 184, 0.35);
    color: var(--text-strong);
    background: var(--surface);
  }

  .site-header .search-panel {
    display: none;
  }

  .site-header.search-open .search-panel {
    display: block;
  }

  .site-header.nav-open .nav-panel {
    display: block;
  }

  @media (max-width: 980px) {
    .search-panel {
      width: calc(100% - 1rem);
    }
  }

  @media (max-width: 860px) {
    .nav-toggle {
      display: inline-flex;
    }

    .nav-panel {
      position: fixed;
      inset: 76px 0 0 0;
      background: rgba(255, 255, 255, 0.98);
      border-top: 1px solid var(--border);
      padding: 1rem 1.5rem 1.5rem;
      box-shadow: 0 24px 50px rgba(15, 23, 42, 0.09);
      transform: translateY(-100%);
      opacity: 0;
      visibility: hidden;
      transition: transform 0.25s ease, opacity 0.25s ease;
      z-index: 60;
    }

    .site-header.nav-open .nav-panel {
      transform: translateY(0);
      opacity: 1;
      visibility: visible;
    }

    .nav-links {
      display: grid;
      gap: 0.65rem;
    }

    .nav-links a {
      width: 100%;
      padding: 0.95rem 1rem;
      border-radius: 16px;
      background: var(--surface);
    }

    .brand-text strong {
      font-size: 0.96rem;
    }

    .brand-text span {
      font-size: 0.78rem;
    }
  }

  @media (min-width: 861px) {
    .nav-toggle {
      display: none;
    }
  }
</style>
