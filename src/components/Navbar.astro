---
import { navItems } from '../data/site';

const { pathname } = Astro.url;
const isActive = (href: string) => {
  const cleanHref = href.replace(/#.*$/, '');
  return pathname === cleanHref || (cleanHref !== '/' && pathname.startsWith(cleanHref));
};
---

<header class="site-header">
  <div class="header-shell">
    <a class="brand" href="/" aria-label="Jutt AI home">
      <span class="brand-mark">J</span>
      <div class="brand-text">
        <strong>Jutt AI</strong>
        <span>Digital growth agency</span>
      </div>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-label="Open navigation">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav class="nav-panel" aria-label="Primary navigation">
      <div class="nav-links">
        {navItems.map((link) => (
          <a href={link.href} class={isActive(link.href) ? 'active' : ''}>{link.label}</a>
        ))}
      </div>
      <a class="quote-button" href="/contact">Get a Quote</a>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    const header = document.querySelector('.site-header');
    if (!header) return;
    const toggle = header.querySelector('.nav-toggle');
    const panel = header.querySelector('.nav-panel');

    toggle?.addEventListener('click', function () {
      const expanded = this.getAttribute('aria-expanded') === 'true';
      header.classList.toggle('nav-open', !expanded);
      this.setAttribute('aria-expanded', String(!expanded));
      panel?.setAttribute('data-open', String(!expanded));
    });

    document.addEventListener('click', function (event) {
      if (!header.contains(event.target) && header.classList.contains('nav-open')) {
        header.classList.remove('nav-open');
        toggle?.setAttribute('aria-expanded', 'false');
        panel?.setAttribute('data-open', 'false');
      }
    });
  })();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 70;
    border-bottom: 1px solid rgba(148, 163, 184, 0.2);
    background: rgba(247, 245, 242, 0.96);
    backdrop-filter: blur(16px);
  }

  .header-shell {
    width: min(1180px, calc(100% - 1.5rem));
    margin: 0 auto;
    padding: 0.9rem 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    color: var(--text-strong);
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 18px;
    background: linear-gradient(135deg, var(--accent), var(--accent-strong));
    color: white;
    font-weight: 800;
    box-shadow: 0 12px 28px rgba(15, 118, 110, 0.18);
  }

  .brand-text {
    display: grid;
    line-height: 1.12;
  }

  .brand-text strong {
    font-size: 1rem;
  }

  .brand-text span {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .nav-panel {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .nav-links a {
    color: var(--muted);
    font-weight: 600;
    padding: 0.65rem 0.9rem;
    border-radius: 999px;
    transition: color 0.2s ease, background 0.2s ease;
  }

  .nav-links a:hover,
  .nav-links a.active {
    color: var(--accent-strong);
    background: var(--accent-soft);
  }

  .quote-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.75rem 1.1rem;
    border-radius: 999px;
    font-weight: 700;
    background: var(--text-strong);
    color: white;
  }

  .nav-toggle {
    display: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-strong);
  }

  .nav-toggle span {
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;
    margin: 4px auto;
    border-radius: 4px;
  }

  @media (max-width: 860px) {
    .nav-toggle {
      display: inline-flex;
      flex-direction: column;
      justify-content: center;
    }

    .nav-panel {
      position: absolute;
      top: calc(100% + 0.5rem);
      left: 1rem;
      right: 1rem;
      display: none;
      flex-direction: column;
      align-items: stretch;
      background: var(--surface);
      padding: 1rem;
      border: 1px solid var(--border);
      border-radius: 24px;
      box-shadow: var(--shadow);
    }

    .site-header.nav-open .nav-panel {
      display: flex;
    }

    .nav-links {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }

    .nav-links a,
    .quote-button {
      width: 100%;
      justify-content: center;
    }
  }
</style>
