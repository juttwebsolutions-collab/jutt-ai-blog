---
const { title = 'Jutt AI Blog', description = 'A simple AI blog with clear articles and practical insights.', url = '/', image = 'https://images.unsplash.com/photo-1677442136019-21780ecad995?auto=format&fit=crop&w=1400&q=80' } = Astro.props;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://juttaiblog.online';
const canonical = `${siteUrl}${url.startsWith('/') ? url : `/${url}`}`;
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Jutt AI Blog',
  url: `${siteUrl}/`
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#2563eb" />
    <meta name="google-site-verification" content="-YF-yBmthxmGphnFLFsIsjRG0307kBGHgDz6lYVXP2g" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta property="og:site_name" content="Jutt AI Blog" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-Q6DPG1PWBH"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-Q6DPG1PWBH');
    </script>
  </head>
  <body>
    <slot />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --bg: #ffffff;
    --surface: #f8fafc;
    --text: #111827;
    --muted: #4b5563;
    --accent: #2563eb;
    --border: #d9e2f0;
  }
  * { box-sizing: border-box; }
  html { background: var(--bg); color: var(--text); scroll-behavior: smooth; }
  body {
    margin: 0;
    min-height: 100vh;
    font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.6;
  }
  img { max-width: 100%; display: block; }
  a { color: var(--accent); text-decoration: none; }
  p { margin: 0 0 1rem; }
  main { max-width: 960px; margin: 0 auto; padding: 1.5rem 1.25rem 3rem; }
  ::selection { background: rgba(37, 99, 235, 0.2); color: var(--text); }
</style>
