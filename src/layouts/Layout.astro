---
const { title = 'Jutt Solutions | Tech News, Guides & Fixes', description = 'A premium technology news site for guides, reviews, and fixes.', url = '/', image = 'https://images.unsplash.com/photo-1677442136019-21780ecad995?auto=format&fit=crop&w=1400&q=80' } = Astro.props;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://juttaiblog.online';
const canonical = `${siteUrl}${url.startsWith('/') ? url : `/${url}`}`;
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Jutt Solutions | Tech News, Guides & Fixes',
  url: `${siteUrl}/`
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#2563eb" />
    <meta name="google-site-verification" content="-YF-yBmthxmGphnFLFsIsjRG0307kBGHgDz6lYVXP2g" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta property="og:site_name" content="Jutt Solutions | Tech News, Guides & Fixes" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-Q6DPG1PWBH"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-Q6DPG1PWBH');
    </script>
  </head>
  <body>
    <div class="page-shell">
      <slot />
    </div>

    <button id="back-to-top" type="button" aria-label="Scroll back to top">↑</button>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', function () {
        var backToTop = document.getElementById('back-to-top');
        if (!backToTop) return;

        function updateVisibility() {
          backToTop.classList.toggle('visible', window.scrollY > 420);
        }

        updateVisibility();
        window.addEventListener('scroll', updateVisibility);
        backToTop.addEventListener('click', function () {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      });
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --bg: #f8fafc;
    --surface: #ffffff;
    --surface-muted: #eef2ff;
    --surface-alt: #f1f5f9;
    --text: #0f172a;
    --text-strong: #020617;
    --muted: #475569;
    --accent: #2563eb;
    --accent-soft: #eff6ff;
    --border: #e2e8f0;
    --shadow: 0 20px 50px rgba(15, 23, 42, 0.09);
    --radius: 24px;
    --radius-sm: 14px;
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--bg);
    color: var(--text);
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-height: 100vh;
    font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.7;
    overflow-x: hidden;
  }

  img {
    max-width: 100%;
    display: block;
    height: auto;
  }

  svg {
    display: block;
  }

  button,
  input,
  textarea,
  select {
    font: inherit;
  }

  button {
    border: none;
    cursor: pointer;
  }

  a {
    color: var(--accent);
    text-decoration: none;
  }

  a:hover,
  a:focus-visible {
    color: var(--accent-strong);
  }

  p {
    margin: 0 0 1.25rem;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    margin: 0 0 1rem;
    color: var(--text-strong);
  }

  main {
    width: min(1180px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 0;
  }

  .page-shell {
    min-height: 100vh;
  }

  .section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.4rem;
  }

  .section-heading h2 {
    font-size: clamp(1.75rem, 2.4vw, 2.4rem);
  }

  .section-heading p {
    margin: 0;
    color: var(--muted);
    font-size: 0.96rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 0.9rem 1.35rem;
    font-weight: 700;
    background: var(--accent);
    color: white;
    transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
  }

  .button:hover,
  .button:focus-visible {
    transform: translateY(-1px);
    box-shadow: 0 18px 34px rgba(37, 99, 235, 0.16);
  }

  .button.secondary {
    background: transparent;
    color: var(--accent-strong);
    border: 1px solid var(--border);
  }

  .button.outline {
    background: var(--surface);
    color: var(--text-strong);
    border: 1px solid var(--border);
  }

  input,
  textarea {
    width: 100%;
    outline: none;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  #back-to-top {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--accent);
    color: white;
    border: none;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.2s ease, transform 0.2s ease;
    z-index: 80;
    box-shadow: 0 16px 35px rgba(37, 99, 235, 0.18);
  }

  #back-to-top.visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 760px) {
    body {
      font-size: 15px;
    }

    main {
      width: calc(100% - 1.5rem);
    }
  }
</style>
