---
import { siteConfig } from '../data/site';
import Analytics from '../components/Analytics.astro';

const {
  title = 'Jutt AI Tools | Free Online Utilities & AI Tools',
  description = 'Free online AI tools and browser-based utilities for writing, text conversion, and productivity.',
  url = '/',
  image = 'https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=1400&q=80',
  analytics = true,
} = Astro.props;

const siteUrl = Astro.site?.origin ?? new URL(siteConfig.domain).origin;
const canonicalPath = url === '/' ? '' : `/${url.replace(/^\/+|\/+$/g, '')}`;
const canonical = `${siteUrl}${canonicalPath}`;
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.siteName,
  url: siteUrl,
  description: siteConfig.baseDescription,
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="yandex-verification" content="8afba3b3b3fc73a0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#0f172a" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta property="og:site_name" content={siteConfig.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {analytics && <Analytics />}
  </head>
  <body>
    <div class="page-shell">
      <slot />
    </div>

    <button id="back-to-top" type="button" aria-label="Scroll back to top">↑</button>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', function () {
        var backToTop = document.getElementById('back-to-top');
        if (!backToTop) return;

        function updateVisibility() {
          backToTop.classList.toggle('visible', window.scrollY > 420);
        }

        updateVisibility();
        window.addEventListener('scroll', updateVisibility);
        backToTop.addEventListener('click', function () {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      });
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --bg: #f6f8f7;
    --surface: #ffffff;
    --surface-soft: #f0f7f5;
    --surface-strong: #e8f4f2;
    --text: #263445;
    --text-strong: #0f172a;
    --muted: #475569;
    --accent: #0f766e;
    --accent-strong: #115e59;
    --accent-soft: #e7f6f3;
    --border: #dbe5e2;
    --shadow: 0 16px 40px rgba(15, 23, 42, 0.07);
    --shadow-hover: 0 22px 52px rgba(15, 23, 42, 0.12);
    --radius: 28px;
    --radius-sm: 16px;
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--bg);
    color: var(--text);
    scroll-behavior: smooth;
    scroll-padding-top: 6rem;
  }

  body {
    margin: 0;
    min-height: 100vh;
    font-family: Inter, 'Segoe UI', sans-serif;
    background:
      radial-gradient(ellipse at 12% 0%, rgba(204, 251, 241, 0.32), transparent 34rem),
      radial-gradient(ellipse at 92% 18%, rgba(226, 232, 240, 0.3), transparent 38rem),
      var(--bg);
    color: var(--text);
    line-height: 1.65;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  img {
    max-width: 100%;
    display: block;
    height: auto;
  }

  svg {
    display: block;
  }

  button,
  input,
  textarea,
  select {
    font: inherit;
  }

  button {
    border: none;
    cursor: pointer;
    min-height: 44px;
    transition: transform 160ms ease, box-shadow 180ms ease, background-color 180ms ease, border-color 180ms ease;
  }

  button:active {
    transform: scale(0.98);
  }

  :where(a, button, input, textarea, select, summary):focus-visible {
    outline: 2px solid #0f766e;
    outline-offset: 3px;
  }

  :where(input:not([type='checkbox']):not([type='radio']), textarea, select) {
    border-color: #cbd5e1;
    border-radius: 0.85rem;
    transition: border-color 160ms ease, box-shadow 160ms ease, background-color 160ms ease;
  }

  :where(input:not([type='checkbox']):not([type='radio']), textarea, select)::placeholder {
    color: #64748b;
    opacity: 1;
  }

  :where(input:not([type='checkbox']):not([type='radio']), textarea, select):focus {
    border-color: #0f766e;
    box-shadow: 0 0 0 3px rgba(20, 184, 166, 0.18);
  }

  :where(input[type='checkbox'], input[type='radio']) {
    accent-color: #0f766e;
  }

  a {
    color: var(--accent);
    text-decoration: none;
    text-underline-offset: 0.2em;
    transition: color 160ms ease, background-color 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  a:hover,
  a:focus-visible {
    color: var(--accent-strong);
  }

  a.text-white:hover,
  a.text-white:focus-visible {
    color: #ffffff;
  }

  p {
    margin: 0 0 1.25rem;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    margin: 0 0 1rem;
    color: var(--text-strong);
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  main {
    width: min(1180px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 0;
  }

  .page-shell {
    min-height: 100vh;
  }

  main section[class*='rounded-3xl'][class*='border-slate-200'][class*='bg-white'] {
    border-color: rgba(203, 213, 225, 0.8);
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.98), rgba(250, 252, 251, 0.96));
    box-shadow: 0 12px 32px rgba(15, 23, 42, 0.055);
  }

  main [data-tool-card],
  main article[data-blog-post] {
    border-color: rgba(203, 213, 225, 0.8);
    box-shadow: 0 5px 16px rgba(15, 23, 42, 0.045);
    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  main [data-tool-card]:hover,
  main article[data-blog-post]:hover {
    border-color: rgba(13, 148, 136, 0.4);
    box-shadow: var(--shadow);
  }

  main article[data-blog-post] > a:first-child {
    background: linear-gradient(135deg, #e2e8f0, #e6f4f1);
  }

  main textarea[readonly],
  main output {
    border-color: #dbe5e2;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 0.95rem 1.45rem;
    font-weight: 700;
    background: var(--accent);
    color: white;
    transition: transform 160ms ease, box-shadow 180ms ease, background-color 180ms ease;
  }

  .button:hover,
  .button:focus-visible {
    transform: translateY(-1px);
    box-shadow: 0 14px 30px rgba(15, 118, 110, 0.2);
  }

  .button:active {
    transform: scale(0.98);
  }

  .button.secondary {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-strong);
  }

  .button.outline {
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text-strong);
  }

  .eyebrow {
    margin: 0 0 0.7rem;
    font-size: 0.76rem;
    letter-spacing: 0.16em;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--accent);
  }

  .page-top {
    padding: 4rem 0 1rem;
  }

  .page-title {
    font-size: clamp(2.4rem, 5vw, 4.2rem);
    line-height: 1.05;
    margin: 0;
  }

  .section-shell {
    padding: 2rem 0 0;
  }

  .grid-2,
  .grid-3 {
    display: grid;
    gap: 1.5rem;
  }

  .grid-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .grid-3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .muted {
    color: var(--muted);
  }

  .card {
    padding: 1.5rem;
    background: linear-gradient(145deg, #ffffff, #fbfdfc);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    box-shadow: 0 10px 28px rgba(15, 23, 42, 0.06);
  }

  @media (max-width: 860px) {
    .grid-2,
    .grid-3 {
      grid-template-columns: 1fr;
    }
  }

  #back-to-top {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--accent-strong);
    color: white;
    font-size: 1.5rem;
    opacity: 0;
    pointer-events: none;
    transform: translateY(8px);
    transition: opacity 180ms ease, transform 180ms ease, box-shadow 180ms ease, background-color 180ms ease;
    box-shadow: 0 12px 28px rgba(15, 23, 42, 0.22);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  #back-to-top:hover {
    background: #0f766e;
    box-shadow: 0 16px 34px rgba(15, 23, 42, 0.26);
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }

  #back-to-top.visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 760px) {
    body {
      font-size: 15px;
    }

    main {
      width: calc(100% - 1.5rem);
    }
  }
</style>
