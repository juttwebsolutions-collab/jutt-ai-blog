---
import { siteConfig } from '../data/site';

const {
  title = 'Jutt AI | Website Development, Shopify, SEO & Digital Growth',
  description = 'Jutt AI builds conversion-focused websites, Shopify stores, SEO improvements, and digital experiences that help businesses grow.',
  url = '/',
  image = 'https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=1400&q=80',
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? siteConfig.domain;
const canonical = `${siteUrl}${url.startsWith('/') ? url : `/${url}`}`;
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.siteName,
  url: `${siteUrl}/`,
  description: siteConfig.baseDescription,
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0f172a" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta property="og:site_name" content={siteConfig.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
  </head>
  <body>
    <div class="page-shell">
      <slot />
    </div>

    <button id="back-to-top" type="button" aria-label="Scroll back to top">↑</button>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', function () {
        var backToTop = document.getElementById('back-to-top');
        if (!backToTop) return;

        function updateVisibility() {
          backToTop.classList.toggle('visible', window.scrollY > 420);
        }

        updateVisibility();
        window.addEventListener('scroll', updateVisibility);
        backToTop.addEventListener('click', function () {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      });
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --bg: #f7f5f2;
    --surface: #ffffff;
    --surface-soft: #f2f6f3;
    --surface-strong: #eef3ff;
    --text: #1c2331;
    --text-strong: #0f172a;
    --muted: #475569;
    --accent: #0f766e;
    --accent-strong: #115e59;
    --accent-soft: #e8faf8;
    --border: #dfe7e3;
    --shadow: 0 18px 48px rgba(15, 23, 42, 0.08);
    --radius: 28px;
    --radius-sm: 16px;
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--bg);
    color: var(--text);
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-height: 100vh;
    font-family: Inter, 'Segoe UI', sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.7;
    overflow-x: hidden;
  }

  img {
    max-width: 100%;
    display: block;
    height: auto;
  }

  svg {
    display: block;
  }

  button,
  input,
  textarea,
  select {
    font: inherit;
  }

  button {
    border: none;
    cursor: pointer;
  }

  a {
    color: var(--accent);
    text-decoration: none;
  }

  a:hover,
  a:focus-visible {
    color: var(--accent-strong);
  }

  p {
    margin: 0 0 1.25rem;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    margin: 0 0 1rem;
    color: var(--text-strong);
  }

  main {
    width: min(1180px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 0;
  }

  .page-shell {
    min-height: 100vh;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 0.95rem 1.45rem;
    font-weight: 700;
    background: var(--accent);
    color: white;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .button:hover,
  .button:focus-visible {
    transform: translateY(-1px);
    box-shadow: 0 18px 34px rgba(15, 118, 110, 0.18);
  }

  .button.secondary {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-strong);
  }

  .button.outline {
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text-strong);
  }

  .eyebrow {
    margin: 0 0 0.7rem;
    font-size: 0.76rem;
    letter-spacing: 0.16em;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--accent);
  }

  .page-top {
    padding: 4rem 0 1rem;
  }

  .page-title {
    font-size: clamp(2.4rem, 5vw, 4.2rem);
    line-height: 1.05;
    margin: 0;
  }

  .section-shell {
    padding: 2rem 0 0;
  }

  .grid-2,
  .grid-3 {
    display: grid;
    gap: 1.5rem;
  }

  .grid-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .grid-3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .muted {
    color: var(--muted);
  }

  .card {
    padding: 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow);
  }

  @media (max-width: 860px) {
    .grid-2,
    .grid-3 {
      grid-template-columns: 1fr;
    }
  }

  #back-to-top {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--accent-strong);
    color: white;
    font-size: 1.5rem;
    opacity: 0;
    pointer-events: none;
    transform: translateY(8px);
    transition: opacity 180ms ease, transform 180ms ease;
    box-shadow: var(--shadow);
  }

  #back-to-top.visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 760px) {
    body {
      font-size: 15px;
    }

    main {
      width: calc(100% - 1.5rem);
    }
  }
</style>
