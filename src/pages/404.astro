---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="404 | Jutt AI Blog" description="The page you requested could not be found." url="/404">
  <Navbar />
  <main class="page-shell">
    <section class="content-card">
      <p class="eyebrow">404</p>
      <h1>Page not found.</h1>
      <p>The page you were looking for has moved, or it never existed. Return home to continue exploring the latest AI stories.</p>
      <a class="btn" href="/">Back to home</a>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .page-shell { max-width: 860px; margin: 0 auto; padding: 3rem 1.25rem 5rem; }
  .content-card { padding: 2rem; border-radius: 1.35rem; background: var(--surface); border: 1px solid var(--border); box-shadow: 0 18px 40px rgba(15, 32, 67, 0.08); }
  .eyebrow { color: var(--accent); text-transform: uppercase; letter-spacing: 0.2em; font-weight: 700; }
  h1 { color: var(--text); font-size: clamp(2rem, 3vw, 2.7rem); }
  p { color: var(--muted); line-height: 1.8; }
  .btn { display: inline-block; margin-top: 0.8rem; padding: 0.92rem 1.2rem; border-radius: 999px; background: linear-gradient(135deg, #2f7cff, #6dd3ff); color: #06101e; text-decoration: none; font-weight: 700; transition: transform 180ms ease, box-shadow 180ms ease; }
  .btn:hover { transform: translateY(-1px); box-shadow: 0 18px 40px rgba(47,124,255,0.18); }
</style>
