---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="About | Jutt AI Blog" description="Learn about the simple mission behind Jutt AI Blog." url="/about">
  <Navbar />
  <main>
    <section class="card">
      <p class="eyebrow">About</p>
      <h1>Simple AI writing for practical readers.</h1>
      <p>Jutt AI Blog shares clear articles about AI strategy, product thinking, and everyday implementation. The goal is to make helpful ideas easier to read and act on.</p>
      <p>Each post is written to be useful, direct, and easy to scan.</p>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .card {
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--surface);
    padding: 1.5rem;
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }
  h1 { font-size: clamp(1.8rem, 3vw, 2.4rem); margin: 0 0 0.75rem; }
  p { color: var(--muted); }
</style>
