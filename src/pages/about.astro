---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ContactCta from '../components/ContactCta.astro';
---

<Layout title="About | Jutt AI" description="Learn more about Jutt AI and the digital services it provides for websites, Shopify stores, SEO, and digital growth." url="/about">
  <Navbar />
  <main>
    <section class="page-top">
      <p class="eyebrow">About Jutt AI</p>
      <h1>Building better digital experiences for small businesses and growing brands.</h1>
      <p>Jutt AI helps businesses improve how they look online, how they sell, and how they communicate value. The focus is on digital experiences that feel clearer, more credible, and easier to use.</p>
    </section>

    <section class="story-grid">
      <div class="card">
        <p class="eyebrow">What we do</p>
        <h2>Strategic website and digital work that supports business goals.</h2>
        <p>Jutt AI works across website development, conversion-focused improvements, SEO support, Shopify storefronts, software ideas, and content systems for modern brands. The aim is to help businesses present themselves better online and guide visitors toward meaningful action.</p>
      </div>
      <div class="card">
        <p class="eyebrow">How we work</p>
        <h2>Practical, thoughtful, and aligned to the real business challenge.</h2>
        <p>Instead of applying generic templates, each project starts by understanding the business offer, pain points, and conversion goals. From there, the strategy is shaped around clarity, usability, and a stronger customer journey.</p>
      </div>
    </section>

    <section class="values-grid">
      <article class="value-card">
        <h3>Clarity</h3>
        <p>Clear messaging, structure, and call-to-action paths help customers understand value faster.</p>
      </article>
      <article class="value-card">
        <h3>Conversion focus</h3>
        <p>Every element is reviewed for how it supports enquiry, trust, and purchase decisions.</p>
      </article>
      <article class="value-card">
        <h3>Digital systems</h3>
        <p>Web design, SEO, e-commerce, content, and digital tools are treated as one connected strategy.</p>
      </article>
    </section>

    <ContactCta title="Need a website or digital system for your business?" href="/contact" />
  </main>
  <Footer />
</Layout>

<style>
  .page-top {
    width: min(1180px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 4rem 0 1rem;
  }

  .page-top h1 {
    font-size: clamp(2.8rem, 5vw, 4.5rem);
    line-height: 1.06;
    max-width: 900px;
    margin: 0;
  }

  .page-top p:last-child {
    margin-top: 1rem;
    max-width: 760px;
    color: var(--muted);
    font-size: 1.08rem;
  }

  main {
    width: min(1180px, calc(100% - 2rem));
    margin: 0 auto;
  }

  .story-grid,
  .values-grid {
    display: grid;
    gap: 1.5rem;
    padding-top: 2rem;
  }

  .story-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .card,
  .value-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 24px;
    padding: 1.5rem;
    box-shadow: var(--shadow);
  }

  .card h2,
  .value-card h3 {
    margin: 0 0 0.8rem;
  }

  .card p,
  .value-card p {
    margin: 0;
    color: var(--muted);
  }

  .values-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    padding-bottom: 0.5rem;
  }

  @media (max-width: 820px) {
    .story-grid,
    .values-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
