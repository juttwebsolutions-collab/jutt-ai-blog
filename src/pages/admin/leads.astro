---
import { env } from 'cloudflare:workers';
import { hasAdminSession } from '../../lib/lead-security';

export const prerender = false;

if (!(await hasAdminSession(Astro.request))) {
  return Astro.redirect('/admin/login', 302);
}

Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');

type Lead = {
  id: string;
  name: string;
  email: string;
  business_name: string;
  service: string;
  budget: string;
  description: string;
  status: 'new' | 'contacted' | 'completed';
  created_at: string;
};

const { results: leads } = await env.LEADS_DB.prepare(`
  SELECT id, name, email, business_name, service, budget, description, status, created_at
  FROM leads
  ORDER BY created_at DESC
`).all<Lead>();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Leads | Jutt AI Admin</title>
    <style>
      :root { font-family: Inter, 'Segoe UI', sans-serif; color: #1c2331; background: #f7f5f2; }
      * { box-sizing: border-box; }
      body { margin: 0; padding: 2rem 1rem; }
      main { width: min(100%, 1000px); margin: 0 auto; }
      header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; }
      h1 { margin: 0; }
      button, select { font: inherit; border-radius: 8px; padding: .65rem .85rem; }
      button { border: 0; color: white; background: #0f766e; font-weight: 700; cursor: pointer; }
      #logout { background: #334155; }
      #dashboard-status { min-height: 1.5em; }
      .lead { margin: 1rem 0; border: 1px solid #dfe7e3; border-radius: 14px; background: white; }
      summary { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem 1rem; padding: 1rem; cursor: pointer; }
      summary strong { margin-right: auto; }
      .badge { border-radius: 99px; padding: .2rem .65rem; background: #e8faf8; color: #115e59; font-size: .85rem; }
      .details { display: grid; gap: .8rem; padding: 0 1rem 1rem; }
      .details p { margin: 0; overflow-wrap: anywhere; }
      .details pre { margin: 0; white-space: pre-wrap; overflow-wrap: anywhere; font: inherit; }
      .status-form { display: flex; align-items: center; gap: .6rem; }
      select { border: 1px solid #dfe7e3; background: white; }
      @media (max-width: 600px) { header { align-items: flex-start; } summary { align-items: flex-start; } }
    </style>
  </head>
  <body>
    <main>
      <header>
        <div>
          <p>Jutt AI · Private area</p>
          <h1>Project enquiries ({leads.length})</h1>
        </div>
        <form id="logout-form"><button id="logout" type="submit">Sign out</button></form>
      </header>
      <p id="dashboard-status" role="status" aria-live="polite"></p>
      {leads.length ? (
        leads.map((lead) => (
          <details class="lead">
            <summary>
              <strong>{lead.name}</strong>
              <span>{lead.service}</span>
              <time datetime={lead.created_at}>{new Date(lead.created_at).toLocaleString('en', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'UTC' })} UTC</time>
              <span class="badge">{lead.status}</span>
            </summary>
            <div class="details">
              <p><strong>Email:</strong> <a href={`mailto:${lead.email}`}>{lead.email}</a></p>
              <p><strong>Business:</strong> {lead.business_name || 'Not provided'}</p>
              <p><strong>Service:</strong> {lead.service}</p>
              <p><strong>Budget:</strong> {lead.budget}</p>
              <p><strong>Project description:</strong></p>
              <pre>{lead.description}</pre>
              <form class="status-form" data-lead-id={lead.id}>
                <label for={`status-${lead.id}`}>Status</label>
                <select id={`status-${lead.id}`} name="status">
                  <option value="new" selected={lead.status === 'new'}>New</option>
                  <option value="contacted" selected={lead.status === 'contacted'}>Contacted</option>
                  <option value="completed" selected={lead.status === 'completed'}>Completed</option>
                </select>
                <button type="submit">Save</button>
              </form>
            </div>
          </details>
        ))
      ) : (
        <p>No enquiries have been submitted yet.</p>
      )}
    </main>
    <script is:inline>
      const dashboardStatus = document.getElementById('dashboard-status');
      document.querySelectorAll('.status-form').forEach((form) => {
        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          const button = form.querySelector('button');
          button.disabled = true;
          dashboardStatus.textContent = 'Saving status…';
          try {
            const response = await fetch(`/api/admin/leads/${encodeURIComponent(form.dataset.leadId)}`, {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ status: new FormData(form).get('status') }),
            });
            const result = await response.json();
            if (!response.ok) {
              dashboardStatus.textContent = result.message || 'Could not save status.';
              return;
            }
            window.location.reload();
          } catch (error) {
            console.error('Lead status update failed:', error);
            dashboardStatus.textContent = 'Could not save status. Please try again.';
          } finally {
            button.disabled = false;
          }
        });
      });

      document.getElementById('logout-form').addEventListener('submit', async (event) => {
        event.preventDefault();
        try {
          const response = await fetch('/api/admin/logout', { method: 'POST' });
          if (!response.ok) throw new Error('The session could not be closed.');
          window.location.assign('/admin/login');
        } catch (error) {
          console.error('Admin logout failed:', error);
          dashboardStatus.textContent = 'Could not sign out. Please try again.';
        }
      });
    </script>
  </body>
</html>
