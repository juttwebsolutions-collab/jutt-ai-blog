---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .map((entry) => {
    const slug = entry.data.slug ?? entry.id.replace(/\.md$/, '');
    const pubDate = entry.data.pubDate instanceof Date ? entry.data.pubDate : new Date(entry.data.pubDate);
    return {
      ...entry.data,
      slug,
      date: pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }),
      image: entry.data.heroImage ?? '/images/blog/default.webp',
      description: entry.data.description
    };
  })
  .sort((a, b) => new Date(b.pubDate).valueOf() - new Date(a.pubDate).valueOf());
---

<Layout title="Latest Articles | Jutt AI Blog" description="Browse the latest AI articles in a simple reading experience." url="/blog">
  <Navbar />
  <main>
    <section class="intro">
      <p class="eyebrow">Latest articles</p>
      <h1>Simple insights, one article at a time.</h1>
      <p>Browse the newest posts published on the blog.</p>
    </section>
    <section class="posts">
      {posts.map((post) => (
        <article class="card">
          <a href={`/blog/${post.slug}`}>
            <img src={post.image} alt={post.title} loading="lazy" decoding="async" />
          </a>
          <div class="card-body">
            <p class="meta">{post.category} · {post.date}</p>
            <h2><a href={`/blog/${post.slug}`}>{post.title}</a></h2>
            <p>{post.description}</p>
          </div>
        </article>
      ))}
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .intro {
    padding: 1rem 0 1.5rem;
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }
  h1 { font-size: clamp(1.8rem, 3vw, 2.4rem); margin: 0 0 0.75rem; }
  .posts {
    display: grid;
    gap: 1rem;
  }
  .card {
    display: grid;
    gap: 1rem;
    grid-template-columns: 220px 1fr;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--surface);
    overflow: hidden;
  }
  .card img { width: 100%; height: 100%; object-fit: cover; min-height: 180px; }
  .card-body { padding: 1rem 1rem 1rem 0; }
  .meta { color: var(--muted); font-size: 0.9rem; margin-bottom: 0.4rem; }
  h2 { font-size: 1.15rem; margin: 0 0 0.5rem; }
  p { color: var(--muted); }
  @media (max-width: 760px) {
    .card { grid-template-columns: 1fr; }
    .card-body { padding: 0 1rem 1rem; }
  }
</style>
