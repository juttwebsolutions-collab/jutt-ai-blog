---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import BlogImage from '../components/BlogImage.astro';
import { getCollection } from 'astro:content';
import { getReadingTime, resolveImagePath } from '../utils/image';

const posts = (await getCollection('blog'))
  .map((entry) => {
    const slug = entry.data.slug ?? entry.id.replace(/\.md$/, '');
    const pubDate = entry.data.pubDate instanceof Date ? entry.data.pubDate : new Date(entry.data.pubDate);
    return {
      ...entry.data,
      slug,
      date: pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }),
      image: resolveImagePath(entry.data.heroImage),
      description: entry.data.description,
      readingTime: getReadingTime(entry.body || entry.data.description)
    };
  })
  .sort((a, b) => new Date(b.pubDate).valueOf() - new Date(a.pubDate).valueOf());
---

<Layout title="Latest Articles | Jutt AI Blog" description="Browse the latest AI articles in a modern reading experience." url="/blog">
  <Navbar />
  <main class="blog-page">
    <section class="hero-section">
      <p class="eyebrow">Latest articles</p>
      <h1>Thoughtful AI stories for modern teams.</h1>
      <p class="intro">Browse the newest posts with a clean, distraction-free reading experience.</p>
    </section>

    <section class="posts-grid">
      {posts.map((post, index) => {
        const cardImages = [
          'https://images.unsplash.com/photo-1516321497487-e288fb19713f?auto=format&fit=crop&w=1200&q=80',
          'https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&w=1200&q=80',
          'https://images.unsplash.com/photo-1526379095098-d400fd0bf935?auto=format&fit=crop&w=1200&q=80',
          'https://images.unsplash.com/photo-1550751827-4bd374c3f58b?auto=format&fit=crop&w=1200&q=80'
        ];
        return (
          <article class="card">
            <a href={`/blog/${post.slug}`} class="image-link">
              <img src={cardImages[index % cardImages.length]} alt={post.title} class="card-image" loading="lazy" decoding="async" />
            </a>
          <div class="card-body">
            <div class="card-meta">
              <span class="badge">{post.category}</span>
              <span>{post.readingTime}</span>
            </div>
            <h2><a href={`/blog/${post.slug}`}>{post.title}</a></h2>
            <p>{post.description}</p>
            <div class="card-footer">
              <span>{post.date}</span>
              <a class="read-more" href={`/blog/${post.slug}`}>Read more</a>
            </div>
          </div>
        </article>
        );
      })}
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .blog-page {
    padding: 1.25rem 0 4rem;
  }
  .hero-section {
    margin-bottom: 1.5rem;
    max-width: 760px;
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }
  h1 {
    font-size: clamp(2rem, 3.2vw, 2.8rem);
    margin: 0 0 0.75rem;
    line-height: 1.15;
  }
  .intro {
    color: var(--muted);
    font-size: 1.02rem;
    margin: 0;
  }
  .posts-grid {
    display: grid;
    gap: 1.1rem;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .card {
    display: flex;
    flex-direction: column;
    border-radius: 1.35rem;
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    overflow: hidden;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 45px rgba(15, 23, 42, 0.12);
  }
  .image-link {
    display: block;
    background: linear-gradient(120deg, #dbeafe, #eff6ff);
  }
  .card-image {
    width: 100%;
    height: 170px;
    object-fit: cover;
  }
  .card-body {
    padding: 0.9rem 0.9rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .card-meta {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    align-items: center;
    font-size: 0.88rem;
    color: var(--muted);
  }
  .badge {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--accent), #60a5fa);
    color: #fff;
    font-weight: 700;
    font-size: 0.78rem;
  }
  h2 {
    font-size: 1.16rem;
    line-height: 1.35;
    margin: 0;
  }
  h2 a {
    color: var(--text);
  }
  .card p {
    color: var(--muted);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    margin-top: auto;
    font-size: 0.92rem;
    color: var(--muted);
  }
  .read-more {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.6rem 0.95rem;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--accent), #3b82f6);
    color: #fff;
    font-weight: 700;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .read-more:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(37, 99, 235, 0.18);
  }
  @media (max-width: 1200px) {
    .posts-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 900px) {
    .posts-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .posts-grid { grid-template-columns: 1fr; }
    .card-body { padding: 1rem; }
  }
</style>
