---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ArticlePage from '../../components/ArticlePage.astro';

export async function getStaticPaths() {
  const entries = await getCollection('blog');
  const posts = entries
    .map((entry) => {
      const slug = entry.data.slug ?? entry.id.replace(/\.md$/, '');
      const pubDate = entry.data.pubDate instanceof Date ? entry.data.pubDate : new Date(entry.data.pubDate);
      return {
        entry,
        slug,
        title: entry.data.title,
        description: entry.data.description,
        category: entry.data.category,
        author: entry.data.author,
        date: pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }),
        image: entry.data.heroImage ?? '/images/blog/default.webp',
        pubDate
      };
    })
    .sort((a, b) => new Date(b.pubDate).valueOf() - new Date(a.pubDate).valueOf());

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: {
      entry: post.entry,
      post: {
        ...post,
        image: post.image,
        date: post.date,
        slug: post.slug
      },
      relatedPosts: posts.filter((item) => item.slug !== post.slug).slice(0, 3).map((item) => ({
        title: item.title,
        slug: item.slug
      }))
    }
  }));
}

const { entry, post, relatedPosts } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={`${post.title} | Jutt AI Blog`} description={post.description} url={`/blog/${post.slug}`} image={post.image}>
  <Navbar />
  <main>
    <ArticlePage post={post} relatedPosts={relatedPosts}>
      <Content />
    </ArticlePage>
  </main>
  <Footer />
</Layout>
