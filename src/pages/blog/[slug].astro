---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ArticlePage from '../../components/ArticlePage.astro';
import { getReadingTime, resolveImagePath } from '../../utils/image';

export async function getStaticPaths() {
  const entries = await getCollection('blog');
  const posts = entries
    .map((entry) => {
      const slug = entry.data.slug ?? entry.id.replace(/\.md$/, '');
      const pubDate = entry.data.pubDate instanceof Date ? entry.data.pubDate : new Date(entry.data.pubDate);
      const headingMatches = entry.body.match(/^(#{1,3})\s+(.+)$/gm) ?? [];
      const toc = headingMatches
        .map((match) => {
          const heading = match.replace(/^#{1,3}\s+/, '').trim();
          const anchor = heading.toLowerCase().replace(/[^a-z0-9\s-]/g, '').replace(/\s+/g, '-').replace(/-+/g, '-');
          return { text: heading, anchor };
        })
        .filter((item) => item.text !== 'Table of Contents' && item.text !== 'FAQs' && item.text !== 'Conclusion');

      return {
        entry,
        slug,
        title: entry.data.title,
        description: entry.data.description,
        category: entry.data.category,
        author: entry.data.author,
        date: pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }),
        image: resolveImagePath(entry.data.heroImage),
        readingTime: getReadingTime(entry.body || entry.data.description),
        pubDate,
        toc
      };
    })
    .sort((a, b) => new Date(b.pubDate).valueOf() - new Date(a.pubDate).valueOf());

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: {
      entry: post.entry,
      post: {
        ...post,
        image: post.image,
        date: post.date,
        slug: post.slug,
        readingTime: post.readingTime
      },
      relatedPosts: posts.filter((item) => item.slug !== post.slug).slice(0, 3).map((item) => ({
        title: item.title,
        slug: item.slug,
        description: item.description
      })),
      toc: post.toc
    }
  }));
}

const { entry, post, relatedPosts, toc } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={`${post.title} | Jutt AI Blog`} description={post.description} url={`/blog/${post.slug}`} image={post.image}>
  <Navbar />
  <main>
    <ArticlePage post={post} relatedPosts={relatedPosts} toc={toc}>
      <Content />
    </ArticlePage>
  </main>
  <Footer />
</Layout>
