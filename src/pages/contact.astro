---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contact | Jutt AI Blog" description="Get in touch about the Jutt AI Blog." url="/contact">
  <Navbar />
  <main>
    <section class="card">
      <p class="eyebrow">Contact</p>
      <h1>Get in touch.</h1>
      <p>Email us at <a href="mailto:juttwebsolutions@gmail.com">juttwebsolutions@gmail.com</a> for editorial questions or collaboration ideas.</p>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .card {
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--surface);
    padding: 1.5rem;
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }
  h1 { font-size: clamp(1.8rem, 3vw, 2.4rem); margin: 0 0 0.75rem; }
  p { color: var(--muted); }
</style>
