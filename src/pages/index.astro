---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PostCard from '../components/PostCard.astro';
import { posts, categories, popularTopics } from '../data/posts';

const featured = posts.find((post) => post.featured) ?? posts[0];
const latest = posts.slice(0, 4);
---

<Layout title="Jutt AI Blog | Premium AI insights for modern teams" description="Discover premium AI strategy, product design, and automation insights on the Jutt AI Blog." url="/">
  <Navbar />
  <main>
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">Premium AI Publishing</p>
        <h1>Where modern AI strategy meets sharp product thinking.</h1>
        <p>Explore the ideas shaping the future of automation, design, governance, and growth.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/blog">Explore articles</a>
          <a class="btn btn-secondary" href="/about">About Jutt</a>
        </div>
      </div>
      <div class="hero-panel">
        <p class="panel-label">Featured insight</p>
        <h2>{featured.title}</h2>
        <p>{featured.description}</p>
        <a href={`/blog/${featured.slug}`}>Read the article →</a>
      </div>
    </section>

    <section class="section">
      <div class="section-heading">
        <p class="eyebrow">Featured article</p>
        <h2>Leading with AI clarity.</h2>
      </div>
      <PostCard post={featured} />
    </section>

    <section class="section">
      <div class="section-heading">
        <p class="eyebrow">Latest articles</p>
        <h2>Fresh thinking for fast-moving teams.</h2>
      </div>
      <div class="grid-2">
        {latest.map((post) => <PostCard post={post} compact />)}
      </div>
    </section>

    <section class="section categories-section">
      <div class="section-heading">
        <p class="eyebrow">Categories</p>
        <h2>Browse by topic.</h2>
      </div>
      <div class="chip-list">
        {categories.filter((category) => category !== 'All').map((category) => <a href="/blog" class="chip">{category}</a>)}
      </div>
    </section>

    <section class="section topics-section">
      <div class="section-heading">
        <p class="eyebrow">Popular topics</p>
        <h2>What readers are exploring now.</h2>
      </div>
      <div class="topic-tags">
        {popularTopics.map((topic) => <span>{topic}</span>)}
      </div>
    </section>

    <section class="section highlights-grid">
      <div class="highlight-card">
        <p class="eyebrow">Why readers stay</p>
        <h3>Practical frameworks</h3>
        <p>Turn AI theory into repeatable systems for product, growth, and operations.</p>
      </div>
      <div class="highlight-card">
        <p class="eyebrow">What you get</p>
        <h3>Sharp editorial perspective</h3>
        <p>Read concise, high-signal analysis that keeps you ahead without the noise.</p>
      </div>
      <div class="highlight-card">
        <p class="eyebrow">Built for teams</p>
        <h3>Designed for momentum</h3>
        <p>Support your next launch, decision, or strategy sprint with grounded insight.</p>
      </div>
    </section>

    <section class="section newsletter-card">
      <div>
        <p class="eyebrow">Newsletter</p>
        <h2>Subscribe for weekly AI insights.</h2>
        <p>Join product leaders and operators receiving concise updates, fresh ideas, and practical frameworks.</p>
      </div>
      <form id="newsletter-form" class="newsletter-form">
        <input type="email" name="email" placeholder="Enter your email" required />
        <button type="submit">Join now</button>
      </form>
    </section>
    <p id="newsletter-status" class="form-status" role="status"></p>

    <section class="section about-cta">
      <div class="about-card">
        <p class="eyebrow">About</p>
        <h2>Built for thoughtful AI adoption.</h2>
        <p>We help teams move from hype to momentum with credible editorial guidance and compelling strategy.</p>
        <a class="btn btn-secondary" href="/about">Meet the mission</a>
      </div>
      <div class="about-card">
        <p class="eyebrow">Ready to collaborate?</p>
        <h2>Let’s create premium content together.</h2>
        <p>From editorial partnerships to bespoke thought leadership, we help organizations tell sharper stories.</p>
        <a class="btn btn-primary" href="/contact">Get in touch</a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  main { max-width: 1180px; margin: 0 auto; padding: 2.5rem 1.25rem 4rem; }
  .hero { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 1.5rem; align-items: center; padding: 3.2rem 0 2rem; }
  .eyebrow { text-transform: uppercase; letter-spacing: 0.2em; font-size: 0.8rem; font-weight: 700; color: var(--accent); }
  h1 { font-size: clamp(2.3rem, 4vw, 3.7rem); color: var(--text); margin: 0.4rem 0 0.8rem; line-height: 1.05; }
  .hero-copy p { color: var(--muted); line-height: 1.75; max-width: 60ch; }
  .hero-actions { display: flex; gap: 0.9rem; flex-wrap: wrap; margin-top: 1.3rem; }
  .btn { text-decoration: none; padding: 0.82rem 1rem; border-radius: 999px; font-weight: 700; }
  .btn-primary { background: linear-gradient(135deg, #2f7cff, #6dd3ff); color: #06101e; }
  .btn-secondary { background: white; color: #1f325c; border: 1px solid var(--border); }
  .hero-panel, .newsletter-card, .about-card, .section { background: var(--surface); border: 1px solid var(--border); border-radius: 1.25rem; box-shadow: 0 18px 40px rgba(15,32,67,0.08); }
  .hero-panel { padding: 1.75rem; background: linear-gradient(135deg, rgba(47,124,255,0.16), rgba(255,255,255,0.95)); border-color: rgba(47,124,255,0.22); }
  .panel-label { color: #1d4ed8; font-weight: 700; }
  .hero-panel h2 { color: #0f172a; font-size: 1.4rem; }
  .hero-panel p { color: #475569; line-height: 1.75; }
  .hero-panel a { color: #2563eb; text-decoration: none; font-weight: 700; }
  .section { padding: 1.4rem; margin-top: 1.4rem; }
  .section-heading { margin-bottom: 1rem; }
  .section-heading h2 { font-size: 1.45rem; color: var(--text); margin: 0.3rem 0 0; }
  .grid-2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .chip-list { display: flex; flex-wrap: wrap; gap: 0.7rem; }
  .chip { color: var(--text); text-decoration: none; padding: 0.6rem 0.9rem; border-radius: 999px; background: rgba(47,124,255,0.08); border: 1px solid rgba(47,124,255,0.12); }
  .topic-tags { display: flex; flex-wrap: wrap; gap: 0.7rem; }
  .topic-tags span { padding: 0.65rem 0.9rem; border-radius: 999px; background: rgba(47,124,255,0.12); color: var(--accent); }
  .newsletter-card { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1.5rem; }
  .newsletter-form { display: flex; gap: 0.7rem; flex-wrap: wrap; }
  .newsletter-form input { min-width: 260px; border: 1px solid var(--border); border-radius: 999px; padding: 0.88rem 1rem; outline: none; background: #f8fafc; color: var(--text); }
  .newsletter-form button { border: 0; border-radius: 999px; padding: 0.8rem 1rem; font-weight: 700; background: linear-gradient(135deg, #2f7cff, #6dd3ff); color: #06101e; cursor: pointer; }
  .highlights-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .highlight-card { padding: 1.2rem; border-radius: 1rem; background: #f8fbff; border: 1px solid rgba(15,32,67,0.08); }
  .highlight-card h3 { color: var(--text); margin: 0.35rem 0 0.5rem; }
  .highlight-card p { color: var(--muted); line-height: 1.7; margin: 0; }
  .form-status { margin-top: 0.7rem; color: var(--accent); min-height: 1.4rem; }
  .form-status.error { color: #ef4444; }
  .about-cta { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .about-card { padding: 1.3rem; }
  @media (max-width: 860px){ .hero, .about-cta, .grid-2, .newsletter-card, .highlights-grid{ grid-template-columns: 1fr; display: grid; } .newsletter-card{ align-items: flex-start; } .newsletter-form{ width: 100%; } .newsletter-form input{ min-width: 0; width: 100%; } }
</style>

<script>
  const newsletterForm = document.getElementById('newsletter-form');
  const newsletterStatus = document.getElementById('newsletter-status');
  if (newsletterForm && newsletterStatus) {
    newsletterForm.addEventListener('submit', (event) => {
      event.preventDefault();
      const formData = new FormData(newsletterForm);
      const email = String(formData.get('email') || '').trim();
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        newsletterStatus.textContent = 'Please enter a valid email address.';
        newsletterStatus.classList.add('error');
        return;
      }
      newsletterStatus.textContent = `Thanks, ${email}! You’re on the list.`;
      newsletterStatus.classList.remove('error');
      newsletterForm.reset();
    });
  }
</script>
