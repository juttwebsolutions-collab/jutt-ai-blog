---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { tools } from '../data/tools';
import { getCollection } from 'astro:content';
import { getReadingTime, resolveImagePath } from '../utils/image';
import '../styles/global.css';

const categories = [...new Set(tools.map(({ category }) => category))];
const latestArticles = (await getCollection('blog'))
  .map((entry) => ({
    title: entry.data.title,
    description: entry.data.description,
    category: entry.data.category,
    author: entry.data.author,
    slug: entry.data.slug ?? entry.id.replace(/\.md$/, ''),
    pubDate: entry.data.pubDate,
    date: entry.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }),
    image: resolveImagePath(entry.data.heroImage),
    readingTime: getReadingTime(entry.body ?? entry.data.description),
  }))
  .sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf())
  .slice(0, 6);
---

<Layout
  title="AI & Utility Tools Hub | Custom Software & Web Development"
  description="Explore free dynamic web tools, hire us for tailored enterprise software and digital solutions, or read our latest technical articles and guides."
>
  <Navbar />
  <main class="mx-auto w-[min(1180px,calc(100%-2rem))] pb-16">
    <section class="relative overflow-hidden py-16 sm:py-24">
      <div class="pointer-events-none absolute -right-20 -top-20 -z-10 h-72 w-72 rounded-full bg-teal-200/50 blur-3xl"></div>
      <p class="mb-4 text-xs font-extrabold uppercase tracking-[0.2em] text-teal-800">Jutt AI · Tools · Software · Guides</p>
      <h1 class="max-w-5xl text-4xl font-black leading-tight tracking-tight text-slate-950 sm:text-6xl">
        AI &amp; Utility Tools Hub | Custom Software &amp; Web Development
      </h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-600">
        Explore free dynamic web tools, hire us for tailored enterprise software &amp; digital solutions, or read our latest technical articles and guides.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="#tools"
          class="inline-flex min-h-12 items-center justify-center rounded-full bg-slate-950 px-6 py-3 font-bold text-white transition hover:-translate-y-0.5 hover:bg-teal-800"
        >Explore Tools <span aria-hidden="true" class="ml-2">↓</span></a>
        <a
          href="/services"
          class="inline-flex min-h-12 items-center justify-center rounded-full border border-slate-300 bg-white px-6 py-3 font-bold text-slate-800 transition hover:-translate-y-0.5 hover:border-teal-700 hover:text-teal-800"
        >Our Services</a>
        <a
          href="/blog"
          class="inline-flex min-h-12 items-center justify-center rounded-full border border-slate-300 bg-white px-6 py-3 font-bold text-slate-800 transition hover:-translate-y-0.5 hover:border-teal-700 hover:text-teal-800"
        >Read Blog</a>
      </div>
    </section>

    <section id="tools" class="scroll-mt-24">
      <div class="mb-7 flex flex-col gap-5">
        <div>
          <p class="mb-2 text-xs font-bold uppercase tracking-[0.16em] text-teal-800">Tool library</p>
          <h2 class="text-3xl font-extrabold tracking-tight text-slate-950">Find the right tool</h2>
        </div>
        <label class="relative block max-w-xl">
          <span class="sr-only">Search tools</span>
          <span aria-hidden="true" class="absolute left-4 top-1/2 -translate-y-1/2 text-lg text-slate-400">⌕</span>
          <input
            id="tool-search"
            type="search"
            placeholder="Search tools..."
            class="w-full rounded-2xl border border-slate-300 bg-white py-3 pl-11 pr-4 text-slate-900 outline-none focus:border-teal-700 focus:ring-4 focus:ring-teal-100"
          />
        </label>
        <nav id="category-filters" class="flex flex-wrap gap-2" aria-label="Filter tools by category">
          <button
            type="button"
            data-category="all"
            aria-pressed="true"
            class="category-filter rounded-full bg-slate-950 px-4 py-2 text-sm font-bold text-white"
          >All tools</button>
          {categories.map((category) => (
            <button
              type="button"
              data-category={category}
              aria-pressed="false"
              class="category-filter rounded-full border border-slate-300 bg-white px-4 py-2 text-sm font-bold text-slate-700 transition hover:border-teal-700 hover:text-teal-800"
            >{category}</button>
          ))}
        </nav>
      </div>

      <p id="tool-result-count" class="mb-4 text-sm text-slate-500" aria-live="polite">
        Showing {tools.length} tools
      </p>
      <div id="tool-grid" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {tools.map((tool) => (
          <a
            href={`/tools/${tool.id}`}
            data-tool-card
            data-category={tool.category}
            data-search={`${tool.title} ${tool.description} ${tool.category} ${tool.type}`}
            class="group flex min-h-56 flex-col rounded-3xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:border-teal-300 hover:shadow-xl"
          >
            <div class="mb-6 flex items-start justify-between gap-3">
              <span class="grid h-12 min-w-12 place-items-center rounded-2xl bg-teal-50 px-2 text-xl font-bold text-teal-800">
                {tool.icon ?? (tool.type === 'ai' ? '✦' : '↔')}
              </span>
              <span class="rounded-full bg-slate-100 px-3 py-1 text-[11px] font-bold uppercase tracking-wide text-slate-600">
                {tool.type === 'ai' ? 'AI' : 'In-browser'}
              </span>
            </div>
            <h3 class="text-lg font-extrabold text-slate-950 group-hover:text-teal-800">{tool.title}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">{tool.description}</p>
            <div class="mt-auto flex items-center justify-between gap-3 pt-5">
              <span class="text-xs font-semibold text-slate-500">{tool.category}</span>
              <span class="text-sm font-bold text-teal-800">Open <span aria-hidden="true">→</span></span>
            </div>
          </a>
        ))}
      </div>
      <p id="no-tools-found" class="hidden rounded-2xl border border-dashed border-slate-300 py-12 text-center text-slate-600">
        No tools match your search. Try another term or category.
      </p>
    </section>

    <section class="mt-20 border-t border-slate-200 pt-14" aria-labelledby="latest-articles-heading">
      <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="mb-2 text-xs font-bold uppercase tracking-[0.16em] text-teal-800">From the Jutt AI blog</p>
          <h2 id="latest-articles-heading" class="text-3xl font-extrabold tracking-tight text-slate-950">
            Latest Articles & Guides
          </h2>
        </div>
        <a
          href="/blog"
          class="inline-flex min-h-11 items-center rounded-full border border-slate-300 bg-white px-5 py-2 text-sm font-bold text-slate-800 transition hover:border-teal-700 hover:text-teal-800"
        >View all articles <span aria-hidden="true" class="ml-2">→</span></a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {latestArticles.map((article) => (
          <article class="group flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-md">
            <a href={`/blog/${article.slug}`} aria-label={`Read ${article.title}`} class="block h-44 w-full shrink-0 overflow-hidden bg-slate-100">
              <img
                src={article.image}
                alt={article.title}
                class="h-full w-full object-cover"
                loading="lazy"
                decoding="async"
              />
            </a>
            <div class="flex flex-1 flex-col justify-between p-4">
              <div class="mb-3 flex items-center gap-3 text-xs text-slate-500">
                <span class="rounded-full bg-teal-50 px-3 py-1 font-bold text-teal-900">{article.category}</span>
              </div>
              <h3 class="line-clamp-2 text-lg font-semibold leading-snug text-slate-950 group-hover:text-teal-800">
                <a href={`/blog/${article.slug}`}>{article.title}</a>
              </h3>
              <p class="mt-2 line-clamp-2 text-sm leading-6 text-slate-600">{article.description}</p>
              <p class="mt-auto flex items-center justify-between gap-2 pt-4 text-xs text-slate-500">
                <span>{article.date}</span>
                <span>{article.readingTime}</span>
              </p>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  const search = document.querySelector<HTMLInputElement>('#tool-search');
  const cards = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-tool-card]'));
  const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('.category-filter'));
  const count = document.querySelector<HTMLElement>('#tool-result-count');
  const empty = document.querySelector<HTMLElement>('#no-tools-found');
  let selectedCategory = 'all';

  const updateTools = () => {
    const query = search?.value.trim().toLocaleLowerCase() ?? '';
    let visibleCount = 0;

    for (const card of cards) {
      const matchesCategory =
        selectedCategory === 'all' || card.dataset.category === selectedCategory;
      const matchesSearch = card.dataset.search?.toLocaleLowerCase().includes(query) ?? false;
      const visible = matchesCategory && matchesSearch;
      card.classList.toggle('hidden', !visible);
      if (visible) visibleCount += 1;
    }

    if (count) count.textContent = `Showing ${visibleCount} ${visibleCount === 1 ? 'tool' : 'tools'}`;
    empty?.classList.toggle('hidden', visibleCount > 0);
  };

  search?.addEventListener('input', updateTools);
  filters.forEach((filter) => {
    filter.addEventListener('click', () => {
      selectedCategory = filter.dataset.category ?? 'all';
      filters.forEach((item) => {
        const selected = item === filter;
        item.setAttribute('aria-pressed', String(selected));
        item.classList.toggle('bg-slate-950', selected);
        item.classList.toggle('text-white', selected);
        item.classList.toggle('border', !selected);
        item.classList.toggle('border-slate-300', !selected);
        item.classList.toggle('bg-white', !selected);
        item.classList.toggle('text-slate-700', !selected);
      });
      updateTools();
    });
  });
</script>
