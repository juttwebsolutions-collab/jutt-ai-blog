---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import BlogImage from '../components/BlogImage.astro';
import { getCollection } from 'astro:content';
import { getReadingTime, resolveImagePath } from '../utils/image';

const posts = (await getCollection('blog'))
  .map((entry) => {
    const slug = entry.data.slug ?? entry.id.replace(/\.md$/, '');
    const pubDate = entry.data.pubDate instanceof Date ? entry.data.pubDate : new Date(entry.data.pubDate);
    return {
      ...entry.data,
      slug,
      date: pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }),
      image: resolveImagePath(entry.data.heroImage),
      description: entry.data.description,
      readingTime: getReadingTime(entry.body || entry.data.description)
    };
  })
  .sort((a, b) => new Date(b.pubDate).valueOf() - new Date(a.pubDate).valueOf());

const featuredPost = posts[0];
const latestPosts = posts.slice(1, 5);
---

<Layout title="Jutt AI Blog" description="A simple AI blog with clear articles and practical insights." url="/">
  <Navbar />
  <main>
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">AI Blog</p>
        <h1>Clear thinking for modern AI work.</h1>
        <p class="hero-text">Practical articles on product, strategy, and everyday AI use, written for fast-moving teams and curious readers.</p>
        <div class="hero-actions">
          <a class="button primary" href="/blog">Explore articles</a>
          <a class="button secondary" href="/about">Why this blog</a>
        </div>
      </div>

      <article class="hero-card">
        <div class="hero-card-media">
          <img
            src="https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=1200&q=80"
            alt={featuredPost?.title ?? 'Featured article'}
            class="hero-visual"
            loading="eager"
            decoding="async"
          />
        </div>
        <div class="hero-card-body">
          <p class="eyebrow">Latest article</p>
          <h2>{featuredPost?.title}</h2>
          <p>{featuredPost?.description}</p>
          <div class="hero-card-meta">
            <span class="badge">{featuredPost?.category}</span>
            <span>{featuredPost?.readingTime}</span>
          </div>
          <a class="read-link" href={featuredPost ? `/blog/${featuredPost.slug}` : '/blog'}>Read story →</a>
        </div>
      </article>
    </section>

    <section class="section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Fresh reads</p>
          <h2>Latest articles</h2>
        </div>
        <a href="/blog">View all</a>
      </div>
      <div class="posts">
        {latestPosts.map((post, index) => {
          const cardImages = [
            'https://images.unsplash.com/photo-1516321497487-e288fb19713f?auto=format&fit=crop&w=1200&q=80',
            'https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&w=1200&q=80',
            'https://images.unsplash.com/photo-1526379095098-d400fd0bf935?auto=format&fit=crop&w=1200&q=80',
            'https://images.unsplash.com/photo-1550751827-4bd374c3f58b?auto=format&fit=crop&w=1200&q=80'
          ];
          return (
            <article class="card">
              <a href={`/blog/${post.slug}`} class="card-image-link">
                <img src={cardImages[index % cardImages.length]} alt={post.title} class="card-image" loading="lazy" decoding="async" />
              </a>
            <div class="card-body">
              <div class="card-meta">
                <span class="badge">{post.category}</span>
                <span>{post.readingTime}</span>
              </div>
              <h3><a href={`/blog/${post.slug}`}>{post.title}</a></h3>
              <p>{post.description}</p>
              <div class="card-footer">
                <span>{post.date}</span>
                <a class="read-link" href={`/blog/${post.slug}`}>Read now</a>
              </div>
            </div>
          </article>
          );
        })}
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .hero {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    padding: 1.25rem 0 2.5rem;
  }
  .hero-copy h1 {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    margin: 0 0 0.9rem;
  }
  .hero-text {
    font-size: 1.05rem;
    color: var(--muted);
    max-width: 640px;
    margin-bottom: 1.2rem;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 1.05rem;
    border-radius: 999px;
    font-weight: 700;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .button:hover {
    transform: translateY(-2px);
  }
  .button.primary {
    background: linear-gradient(135deg, var(--accent), #60a5fa);
    color: white;
    box-shadow: 0 12px 25px rgba(37, 99, 235, 0.16);
  }
  .button.secondary {
    background: var(--surface);
    color: var(--accent);
    border: 1px solid var(--border);
  }
  .hero-card,
  .section,
  .card {
    border: 1px solid var(--border);
    border-radius: 1.5rem;
    background: var(--surface);
    box-shadow: var(--shadow);
  }
  .hero-card {
    overflow: hidden;
    display: grid;
    max-width: 440px;
    margin-left: auto;
    min-height: 100%;
  }
  .hero-card-media {
    background: linear-gradient(120deg, #dbeafe, #eff6ff);
  }
  .hero-visual {
    width: 100%;
    height: 210px;
    object-fit: cover;
  }
  .hero-card-body {
    padding: 0.95rem 1rem 1rem;
  }
  .hero-card h2 {
    margin: 0 0 0.5rem;
    font-size: 1.3rem;
  }
  .hero-card p {
    color: var(--muted);
  }
  .hero-card-meta,
  .card-meta,
  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
    font-size: 0.92rem;
    color: var(--muted);
  }
  .badge {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--accent), #60a5fa);
    color: #fff;
    font-size: 0.78rem;
    font-weight: 700;
  }
  .section {
    padding: 1.25rem;
  }
  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .section-heading h2 {
    margin: 0;
    font-size: 1.35rem;
  }
  .section-heading a {
    font-weight: 700;
  }
  .posts {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .card {
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 25px 55px rgba(15, 23, 42, 0.11);
  }
  .card-image-link {
    display: block;
    background: linear-gradient(120deg, #dbeafe, #eff6ff);
  }
  .card-image {
    width: 100%;
    height: 170px;
    object-fit: cover;
  }
  .card-body {
    padding: 0.9rem;
    display: grid;
    gap: 0.6rem;
  }
  .card h3 {
    margin: 0;
    font-size: 1.1rem;
  }
  .card h3 a {
    color: var(--text);
  }
  .card p {
    color: var(--muted);
    margin: 0;
  }
  .read-link {
    color: var(--accent);
    font-weight: 700;
  }
  @media (max-width: 1200px) {
    .posts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .posts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .posts {
      grid-template-columns: 1fr;
    }
    .section {
      padding: 1rem;
    }
    .hero-card-body,
    .card-body {
      padding: 1rem;
    }
    .hero-copy h1 {
      font-size: 2rem;
    }
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .button {
      width: 100%;
    }
  }
</style>
