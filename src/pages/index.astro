---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import BlogImage from '../components/BlogImage.astro';
import { getCollection } from 'astro:content';
import { resolveImagePath } from '../utils/image';

const posts = (await getCollection('blog'))
  .map((entry) => {
    const slug = entry.data.slug ?? entry.id.replace(/\.md$/, '');
    const pubDate = entry.data.pubDate instanceof Date ? entry.data.pubDate : new Date(entry.data.pubDate);
    return {
      ...entry.data,
      slug,
      date: pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }),
      image: resolveImagePath(entry.data.heroImage),
      description: entry.data.description
    };
  })
  .sort((a, b) => new Date(b.pubDate).valueOf() - new Date(a.pubDate).valueOf());

const [featuredPost, ...latestPosts] = posts;
---

<Layout title="Jutt AI Blog" description="A simple AI blog with clear articles and practical insights." url="/">
  <Navbar />
  <main>
    <section class="hero">
      <div>
        <p class="eyebrow">AI Blog</p>
        <h1>Clear thinking for modern AI work.</h1>
        <p>Practical articles on strategy, product, and everyday AI use.</p>
        <a class="button" href="/blog">Read the latest articles</a>
      </div>
      <div class="hero-card">
        <div class="hero-card-media">
          <BlogImage
            src={featuredPost?.image}
            alt={featuredPost?.title ?? 'Featured article'}
            class="hero-visual"
            priority={true}
          />
        </div>
        <div class="hero-card-body">
          <p class="eyebrow">Latest article</p>
          <h2>{featuredPost?.title}</h2>
          <p>{featuredPost?.description}</p>
          <a class="button secondary" href={`/blog/${featuredPost?.slug}`}>Read more →</a>
        </div>
      </div>
    </section>

    <section class="section">
      <h2>Latest articles</h2>
      <div class="posts">
        {latestPosts.map((post) => (
          <article class="card">
            <a href={`/blog/${post.slug}`}>
              <BlogImage
                src={post.image}
                alt={post.title}
                class="card-image"
              />
            </a>
            <div class="card-body">
              <p class="meta">{post.category} · {post.date}</p>
              <h3><a href={`/blog/${post.slug}`}>{post.title}</a></h3>
              <p>{post.description}</p>
              <a class="button secondary" href={`/blog/${post.slug}`}>Read more</a>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .hero {
    display: grid;
    gap: 1.75rem;
    grid-template-columns: 1.4fr 1fr;
    align-items: stretch;
    padding: 2.5rem 0 3rem;
  }
  .hero p {
    max-width: 40rem;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.8;
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }
  h1 {
    font-size: clamp(2.5rem, 4vw, 3.8rem);
    margin: 0 0 1rem;
    max-width: 11ch;
  }
  .hero-card,
  .card,
  .section {
    border: 1px solid var(--border);
    border-radius: 1.5rem;
    background: var(--surface);
    box-shadow: var(--shadow);
  }
  .hero-card {
    overflow: hidden;
    display: grid;
    grid-template-rows: auto 1fr;
    min-height: 100%;
  }
  .hero-card-media {
    overflow: hidden;
    background: linear-gradient(135deg, #e0efff, #eff8ff);
  }
  .hero-visual {
    width: 100%;
    height: 100%;
    min-height: 260px;
    object-fit: cover;
    display: block;
  }
  .hero-card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .hero-card h2 {
    margin: 0;
    font-size: 1.8rem;
    line-height: 1.2;
  }
  .hero-card p {
    margin: 0;
    color: var(--muted);
    line-height: 1.75;
  }
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.75rem;
    padding: 0.9rem 1.35rem;
    border-radius: 999px;
    background: var(--accent);
    color: white;
    font-weight: 700;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .button:hover {
    transform: translateY(-1px);
    box-shadow: 0 12px 30px rgba(37, 99, 235, 0.17);
  }
  .button.secondary {
    background: transparent;
    color: var(--accent);
    border: 1px solid var(--border);
  }
  .section {
    padding: 1.75rem 0 0;
  }
  .section h2 {
    font-size: clamp(1.8rem, 2.2vw, 2.4rem);
    margin: 0 0 1.25rem;
  }
  .posts {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: stretch;
  }
  .card {
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    border-radius: 1.25rem;
    border: 1px solid var(--border);
    background: var(--surface);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    min-height: 100%;
  }
  .card:hover {
    transform: translateY(-5px);
    box-shadow: 0 18px 40px rgba(15, 23, 42, 0.12);
  }
  .card-image {
    width: 100%;
    height: 240px;
    object-fit: cover;
    display: block;
  }
  .card-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    min-height: 1px;
  }

  .card-body > .card-cta {
    margin-top: auto;
  }

  .meta {
    color: var(--muted);
    font-size: 0.9rem;
    margin-bottom: 0.25rem;
  }
  .card h3 {
    margin: 0;
    font-size: 1.2rem;
    line-height: 1.35;
  }
  .card p {
    color: var(--muted);
    margin: 0;
    line-height: 1.75;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-footer {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    color: var(--muted);
    font-size: 0.92rem;
  }
  @media (max-width: 980px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .hero-card {
      min-height: auto;
    }
    .hero-card-media {
      min-height: 240px;
    }
  }
  @media (max-width: 760px) {
    .posts {
      grid-template-columns: 1fr;
    }
  }
</style>
