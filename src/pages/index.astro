---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .map((entry) => {
    const slug = entry.data.slug ?? entry.id.replace(/\.md$/, '');
    const pubDate = entry.data.pubDate instanceof Date ? entry.data.pubDate : new Date(entry.data.pubDate);
    return {
      ...entry.data,
      slug,
      date: pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }),
      image: entry.data.heroImage ?? '/images/blog/default.webp',
      description: entry.data.description
    };
  })
  .sort((a, b) => new Date(b.pubDate).valueOf() - new Date(a.pubDate).valueOf());

const [featuredPost, ...latestPosts] = posts;
---

<Layout title="Jutt AI Blog" description="A simple AI blog with clear articles and practical insights." url="/">
  <Navbar />
  <main>
    <section class="hero">
      <div>
        <p class="eyebrow">AI Blog</p>
        <h1>Clear thinking for modern AI work.</h1>
        <p>Practical articles on strategy, product, and everyday AI use.</p>
        <a class="button" href="/blog">Read the latest articles</a>
      </div>
      <div class="hero-card">
        <p class="eyebrow">Latest article</p>
        <h2>{featuredPost?.title}</h2>
        <p>{featuredPost?.description}</p>
        <a href={`/blog/${featuredPost?.slug}`}>Read more →</a>
      </div>
    </section>

    <section class="section">
      <h2>Latest articles</h2>
      <div class="posts">
        {latestPosts.map((post) => (
          <article class="card">
            <a href={`/blog/${post.slug}`}>
              <img src={post.image} alt={post.title} loading="lazy" decoding="async" />
            </a>
            <div class="card-body">
              <p class="meta">{post.category} · {post.date}</p>
              <h3><a href={`/blog/${post.slug}`}>{post.title}</a></h3>
              <p>{post.description}</p>
              <a class="button secondary" href={`/blog/${post.slug}`}>Read more</a>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .hero {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1.2fr 0.8fr;
    align-items: center;
    padding: 2rem 0 2.5rem;
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }
  h1 { font-size: clamp(2rem, 4vw, 3rem); margin: 0 0 0.75rem; }
  .hero-card, .card, .section {
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--surface);
  }
  .hero-card { padding: 1.25rem; }
  .hero-card h2 { margin-top: 0.2rem; font-size: 1.25rem; }
  .button {
    display: inline-block;
    margin-top: 0.75rem;
    padding: 0.7rem 1rem;
    border-radius: 999px;
    background: var(--accent);
    color: white;
    font-weight: 600;
  }
  .button.secondary {
    background: transparent;
    color: var(--accent);
    border: 1px solid var(--border);
  }
  .section { padding: 1.25rem; }
  .posts {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .card { overflow: hidden; }
  .card img { width: 100%; height: 220px; object-fit: cover; }
  .card-body { padding: 1rem; }
  .meta { color: var(--muted); font-size: 0.9rem; margin-bottom: 0.4rem; }
  .card h3 { margin: 0 0 0.4rem; font-size: 1.1rem; }
  .card p { color: var(--muted); }
  @media (max-width: 760px) {
    .hero, .posts { grid-template-columns: 1fr; }
  }
</style>
