---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Privacy Policy | Jutt AI Tools" description="Review the privacy policy for Jutt AI Tools." url="/privacy">
  <Navbar />
  <main>
    <section class="card">
      <p class="eyebrow">Privacy Policy</p>
      <h1>Simple privacy practices.</h1>
      <p>This site may use standard hosting, analytics, and advertising services to operate the tool platform and understand visitor interest. We keep data collection minimal and use it to maintain and improve the site.</p>
      <p>If you have questions, contact us at <a href="mailto:juttwebsolutions@gmail.com">juttwebsolutions@gmail.com</a>.</p>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .card {
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--surface);
    padding: 1.5rem;
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }
  h1 { font-size: clamp(1.8rem, 3vw, 2.4rem); margin: 0 0 0.75rem; }
  p { color: var(--muted); }
</style>
