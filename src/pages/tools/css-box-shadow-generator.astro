---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';
---

<Layout
  title="CSS Box Shadow Generator | Jutt AI Tools"
  description="Create CSS box shadows with interactive offset, blur, spread, color, and opacity controls. Preview and copy the CSS instantly."
  url="/tools/css-box-shadow-generator"
>
  <Navbar />
  <main class="mx-auto w-[min(1000px,calc(100%-2rem))] pb-12">
    <header class="py-12 sm:py-16">
      <a href="/tools" class="text-sm font-bold text-teal-800 hover:text-teal-950">← All tools</a>
      <p class="mb-2 mt-7 text-xs font-extrabold uppercase tracking-[0.16em] text-teal-800">Design &amp; developer tools · Runs in your browser</p>
      <h1 class="text-3xl font-black tracking-tight text-slate-950 sm:text-4xl">CSS Box Shadow Generator</h1>
      <p class="mt-3 max-w-2xl leading-7 text-slate-600">Tune a shadow with live controls and preview the result before copying the CSS.</p>
    </header>

    <section class="grid gap-5 rounded-3xl border border-slate-200 bg-white/90 p-5 shadow-sm backdrop-blur-md sm:p-8 lg:grid-cols-2" aria-label="CSS box shadow generator">
      <div class="space-y-5">
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block text-sm font-bold text-slate-900">
            Horizontal offset <output id="horizontal-value" for="horizontal">8px</output>
            <input id="horizontal" type="range" min="-50" max="50" value="8" class="mt-3 block w-full accent-teal-700" />
          </label>
          <label class="block text-sm font-bold text-slate-900">
            Vertical offset <output id="vertical-value" for="vertical">8px</output>
            <input id="vertical" type="range" min="-50" max="50" value="8" class="mt-3 block w-full accent-teal-700" />
          </label>
          <label class="block text-sm font-bold text-slate-900">
            Blur <output id="blur-value" for="blur">16px</output>
            <input id="blur" type="range" min="0" max="100" value="16" class="mt-3 block w-full accent-teal-700" />
          </label>
          <label class="block text-sm font-bold text-slate-900">
            Spread <output id="spread-value" for="spread">0px</output>
            <input id="spread" type="range" min="-50" max="50" value="0" class="mt-3 block w-full accent-teal-700" />
          </label>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <label class="block text-sm font-bold text-slate-900">
            Shadow color
            <input id="shadow-color" type="color" value="#0f172a" class="mt-2 block h-12 w-full cursor-pointer rounded-xl border border-slate-300 bg-white p-1" />
          </label>
          <label class="block text-sm font-bold text-slate-900">
            Opacity <output id="opacity-value" for="opacity">25%</output>
            <input id="opacity" type="range" min="0" max="100" value="25" class="mt-3 block w-full accent-teal-700" />
          </label>
        </div>
      </div>
      <div class="flex min-h-64 items-center justify-center overflow-hidden rounded-2xl border border-dashed border-slate-300 bg-slate-100 p-8">
        <div id="shadow-preview" class="grid h-36 w-44 place-items-center rounded-2xl bg-white text-sm font-bold text-slate-700">Live preview</div>
      </div>
      <div class="space-y-2 lg:col-span-2">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <label for="shadow-output" class="text-sm font-bold text-slate-900">CSS output</label>
          <button id="copy-shadow" type="button" class="rounded-full border border-slate-300 bg-white px-4 py-2 text-sm font-bold text-slate-700 transition hover:border-teal-700 hover:text-teal-800">Copy to Clipboard</button>
        </div>
        <textarea id="shadow-output" rows="2" readonly spellcheck="false" class="block w-full resize-y rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 font-mono text-sm leading-6 text-slate-900 outline-none"></textarea>
        <p id="shadow-status" class="m-0 text-sm text-slate-600" role="status" aria-live="polite"></p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  const shadowInputs = {
    horizontal: document.querySelector<HTMLInputElement>('#horizontal'),
    vertical: document.querySelector<HTMLInputElement>('#vertical'),
    blur: document.querySelector<HTMLInputElement>('#blur'),
    spread: document.querySelector<HTMLInputElement>('#spread'),
    color: document.querySelector<HTMLInputElement>('#shadow-color'),
    opacity: document.querySelector<HTMLInputElement>('#opacity'),
  };
  const shadowPreview = document.querySelector<HTMLDivElement>('#shadow-preview');
  const shadowOutput = document.querySelector<HTMLTextAreaElement>('#shadow-output');
  const shadowStatus = document.querySelector<HTMLParagraphElement>('#shadow-status');

  function updateShadow(): void {
    if (!shadowInputs.horizontal || !shadowInputs.vertical || !shadowInputs.blur ||
      !shadowInputs.spread || !shadowInputs.color || !shadowInputs.opacity || !shadowOutput) return;

    const horizontal = Number(shadowInputs.horizontal.value);
    const vertical = Number(shadowInputs.vertical.value);
    const blur = Number(shadowInputs.blur.value);
    const spread = Number(shadowInputs.spread.value);
    const opacity = Number(shadowInputs.opacity.value);
    const hex = shadowInputs.color.value;
    const red = parseInt(hex.slice(1, 3), 16);
    const green = parseInt(hex.slice(3, 5), 16);
    const blue = parseInt(hex.slice(5, 7), 16);
    const color = `rgba(${red}, ${green}, ${blue}, ${(opacity / 100).toFixed(2)})`;
    const boxShadow = `${horizontal}px ${vertical}px ${blur}px ${spread}px ${color}`;

    shadowOutput.value = `box-shadow: ${boxShadow};`;
    if (shadowPreview) shadowPreview.style.boxShadow = boxShadow;
    for (const [id, value] of [
      ['horizontal-value', `${horizontal}px`],
      ['vertical-value', `${vertical}px`],
      ['blur-value', `${blur}px`],
      ['spread-value', `${spread}px`],
      ['opacity-value', `${opacity}%`],
    ]) {
      const output = document.getElementById(id);
      if (output) output.textContent = value;
    }
  }

  Object.values(shadowInputs).forEach((input) => input?.addEventListener('input', updateShadow));
  document.querySelector<HTMLButtonElement>('#copy-shadow')?.addEventListener('click', async () => {
    if (!shadowOutput || !shadowStatus) return;
    try {
      await navigator.clipboard.writeText(shadowOutput.value);
      shadowStatus.textContent = 'CSS copied to clipboard.';
    } catch {
      shadowStatus.textContent = 'Could not access the clipboard. Please copy the CSS manually.';
    }
  });
  updateShadow();
</script>
