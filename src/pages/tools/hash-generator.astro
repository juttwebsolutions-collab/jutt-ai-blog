---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';
---

<Layout
  title="MD5, SHA-256 & SHA-512 Hash Generator | Jutt AI Tools"
  description="Generate MD5, SHA-1, SHA-256, and SHA-512 hashes from text locally in your browser."
  url="/tools/hash-generator"
>
  <Navbar />
  <main class="mx-auto w-[min(900px,calc(100%-2rem))] pb-12">
    <header class="py-12 sm:py-16">
      <a href="/" class="text-sm font-bold text-teal-800 hover:text-teal-950">← All tools</a>
      <p class="mb-2 mt-7 text-xs font-extrabold uppercase tracking-[0.16em] text-teal-800">Design &amp; developer tools · Runs in your browser</p>
      <h1 class="text-3xl font-black tracking-tight text-slate-950 sm:text-4xl">MD5, SHA-256 &amp; SHA-512 Hash Generator</h1>
      <p class="mt-3 max-w-2xl leading-7 text-slate-600">Generate common text hashes locally with Web Crypto and a small built-in MD5 implementation. Hashes are not encryption or password protection.</p>
    </header>

    <section class="space-y-5 rounded-3xl border border-slate-200 bg-white p-5 shadow-sm sm:p-8" aria-label="Hash generator">
      <div>
        <label for="hash-input" class="mb-2 block text-sm font-bold text-slate-900">Text to hash</label>
        <textarea id="hash-input" rows="5" spellcheck="false" placeholder="Type or paste text here..." class="block w-full resize-y rounded-2xl border border-slate-300 bg-white px-4 py-4 text-sm leading-6 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-teal-600 focus:ring-4 focus:ring-teal-100"></textarea>
      </div>

      <div id="hash-alert" class="hidden rounded-2xl border px-4 py-3 text-sm" role="status" aria-live="polite"></div>
      <div class="space-y-3">
        {['MD5', 'SHA-1', 'SHA-256', 'SHA-512'].map((algorithm) => {
          const id = algorithm.toLowerCase().replace('-', '');
          return (
            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
              <div class="mb-2 flex items-center justify-between gap-3">
                <h2 class="m-0 text-sm font-bold text-slate-900">{algorithm}</h2>
                <button type="button" data-copy-hash={id} class="shrink-0 text-sm font-bold text-teal-800 hover:text-teal-950">Copy Hash</button>
              </div>
              <output id={`hash-${id}`} class="block min-h-6 break-all font-mono text-xs leading-6 text-slate-700" aria-live="polite">Enter text to generate a hash.</output>
            </div>
          );
        })}
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  const hashInput = document.querySelector<HTMLTextAreaElement>('#hash-input');
  const hashAlert = document.querySelector<HTMLDivElement>('#hash-alert');
  let hashRevision = 0;

  function showHashMessage(message: string, isError = false): void {
    if (!hashAlert) return;
    hashAlert.textContent = message;
    hashAlert.className = isError
      ? 'rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800'
      : 'rounded-2xl border border-teal-200 bg-teal-50 px-4 py-3 text-sm text-teal-900';
  }

  function toHex(bytes: Uint8Array): string {
    return Array.from(bytes, (byte) => byte.toString(16).padStart(2, '0')).join('');
  }

  function md5(input: Uint8Array): string {
    const paddedLength = (Math.floor((input.length + 8) / 64) + 1) * 64;
    const padded = new Uint8Array(paddedLength);
    padded.set(input);
    padded[input.length] = 0x80;
    const view = new DataView(padded.buffer);
    const bitLength = input.length * 8;
    view.setUint32(paddedLength - 8, bitLength >>> 0, true);
    view.setUint32(paddedLength - 4, Math.floor(bitLength / 0x100000000), true);

    let a0 = 0x67452301;
    let b0 = 0xefcdab89;
    let c0 = 0x98badcfe;
    let d0 = 0x10325476;
    const shifts = [
      7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22,
      5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20,
      4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23,
      6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21,
    ];
    const constants = Array.from({ length: 64 }, (_, index) => Math.floor(Math.abs(Math.sin(index + 1)) * 0x100000000));

    for (let offset = 0; offset < paddedLength; offset += 64) {
      const words = new Int32Array(16);
      for (let index = 0; index < 16; index += 1) words[index] = view.getInt32(offset + index * 4, true);
      let a = a0;
      let b = b0;
      let c = c0;
      let d = d0;

      for (let index = 0; index < 64; index += 1) {
        let value: number;
        let wordIndex: number;
        if (index < 16) {
          value = (b & c) | (~b & d);
          wordIndex = index;
        } else if (index < 32) {
          value = (d & b) | (~d & c);
          wordIndex = (5 * index + 1) % 16;
        } else if (index < 48) {
          value = b ^ c ^ d;
          wordIndex = (3 * index + 5) % 16;
        } else {
          value = c ^ (b | ~d);
          wordIndex = (7 * index) % 16;
        }
        const sum = (a + value + constants[index] + words[wordIndex]) | 0;
        const rotated = (sum << shifts[index]) | (sum >>> (32 - shifts[index]));
        const nextB = (b + rotated) | 0;
        a = d;
        d = c;
        c = b;
        b = nextB;
      }
      a0 = (a0 + a) | 0;
      b0 = (b0 + b) | 0;
      c0 = (c0 + c) | 0;
      d0 = (d0 + d) | 0;
    }

    const digest = new Uint8Array(16);
    const result = new DataView(digest.buffer);
    result.setInt32(0, a0, true);
    result.setInt32(4, b0, true);
    result.setInt32(8, c0, true);
    result.setInt32(12, d0, true);
    return toHex(digest);
  }

  async function updateHashes(): Promise<void> {
    if (!hashInput) return;
    const revision = ++hashRevision;
    const input = new TextEncoder().encode(hashInput.value);
    const md5Output = document.querySelector<HTMLOutputElement>('#hash-md5');
    if (md5Output) md5Output.textContent = md5(input);
    try {
      const algorithms = [
        { algorithm: 'SHA-1', id: 'sha1' },
        { algorithm: 'SHA-256', id: 'sha256' },
        { algorithm: 'SHA-512', id: 'sha512' },
      ] as const;
      const results = await Promise.all(algorithms.map(async ({ algorithm }) => {
        const digest = await window.crypto.subtle.digest(algorithm, input);
        return toHex(new Uint8Array(digest));
      }));
      if (revision !== hashRevision) return;
      algorithms.forEach(({ id }, index) => {
        const output = document.querySelector<HTMLOutputElement>(`#hash-${id}`);
        if (output) output.textContent = results[index];
      });
      if (input.length) showHashMessage('Hashes are generated locally in your browser.');
      else if (hashAlert) {
        hashAlert.textContent = '';
        hashAlert.className = 'hidden rounded-2xl border px-4 py-3 text-sm';
      }
    } catch {
      if (revision === hashRevision) showHashMessage('Web Crypto is unavailable in this browser context. Try a secure context such as HTTPS or localhost.', true);
    }
  }

  hashInput?.addEventListener('input', () => {
    document.querySelectorAll<HTMLOutputElement>('[id^="hash-"]').forEach((output) => {
      output.textContent = hashInput.value ? 'Generating…' : 'Enter text to generate a hash.';
    });
    void updateHashes();
  });
  document.querySelectorAll<HTMLButtonElement>('[data-copy-hash]').forEach((button) => {
    button.addEventListener('click', async () => {
      const id = button.dataset.copyHash;
      const output = id ? document.querySelector<HTMLOutputElement>(`#hash-${id}`) : null;
      if (!output || output.textContent === 'Enter text to generate a hash.' || output.textContent === 'Generating…') {
        showHashMessage('Enter text to generate a hash before copying.', true);
        return;
      }
      try {
        await navigator.clipboard.writeText(output.textContent ?? '');
        showHashMessage(`${id?.toUpperCase()} hash copied to the clipboard.`);
      } catch {
        showHashMessage('Could not access the clipboard. Please select and copy the hash manually.', true);
      }
    });
  });
</script>
