---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { newestTools, tools } from '../../data/tools';
import '../../styles/global.css';

const categories = [...new Set(tools.map(({ category }) => category))];
---

<Layout
  title="All Free Online Tools | Jutt AI Tools"
  description="Browse all free browser-based utilities and AI tools from Jutt AI."
  url="/tools"
>
  <Navbar />
  <main class="mx-auto w-[min(1180px,calc(100%-2rem))] pb-16">
    <header class="py-12 sm:py-16">
      <a href="/" class="text-sm font-bold text-teal-800 hover:text-teal-950">← Home</a>
      <p class="mb-2 mt-7 text-xs font-extrabold uppercase tracking-[0.16em] text-teal-800">Jutt AI · Free online utilities</p>
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h1 class="text-3xl font-black tracking-tight text-slate-950 sm:text-4xl">All tools, one place</h1>
          <p class="mb-0 mt-3 max-w-2xl leading-7 text-slate-600">Explore every utility and generator. New tools appear first, and browser tools run on your device.</p>
        </div>
        <span class="w-fit rounded-full border border-teal-200 bg-teal-50 px-3 py-1.5 text-sm font-bold text-teal-900">{tools.length} tools</span>
      </div>
    </header>

    <section id="all-tools" aria-labelledby="all-tools-heading">
      <div class="mb-6 flex flex-col gap-5">
        <div>
          <h2 id="all-tools-heading" class="text-2xl font-extrabold tracking-tight text-slate-950">Browse the library</h2>
        </div>
        <label class="relative block max-w-xl">
          <span class="sr-only">Search all tools</span>
          <span aria-hidden="true" class="absolute left-4 top-1/2 -translate-y-1/2 text-lg text-slate-400">⌕</span>
          <input
            id="all-tools-search"
            type="search"
            placeholder="Search all tools..."
            class="w-full rounded-2xl border border-slate-300 bg-white py-3 pl-11 pr-4 text-slate-900 outline-none focus:border-teal-700 focus:ring-4 focus:ring-teal-100"
          />
        </label>
        <nav id="all-tools-filters" class="flex flex-wrap gap-2" aria-label="Filter tools by category">
          <button
            type="button"
            data-category="all"
            aria-pressed="true"
            class="all-tools-filter rounded-full bg-slate-950 px-4 py-2 text-sm font-bold text-white"
          >All tools</button>
          {categories.map((category) => (
            <button
              type="button"
              data-category={category}
              aria-pressed="false"
              class="all-tools-filter rounded-full border border-slate-300 bg-white px-4 py-2 text-sm font-bold text-slate-700 transition hover:border-teal-700 hover:text-teal-800"
            >{category}</button>
          ))}
        </nav>
      </div>

      <p id="all-tools-count" class="mb-4 text-sm text-slate-500" aria-live="polite">Showing {tools.length} tools</p>
      <div id="all-tools-grid" class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {newestTools.map((tool, index) => (
          <a
            href={`/tools/${tool.id}`}
            aria-label={`Open ${tool.title}: ${tool.description}`}
            data-all-tool-card
            data-category={tool.category}
            data-search={`${tool.title} ${tool.description} ${tool.category} ${tool.type}`}
            style={`--card-index: ${index}`}
            class="all-tool-card group grid min-h-[112px] grid-cols-[2.5rem_minmax(0,1fr)] items-center gap-x-3 gap-y-1 rounded-2xl border border-slate-200 bg-white p-3 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-teal-300 hover:shadow-md motion-reduce:transition-none motion-reduce:hover:translate-y-0 sm:min-h-[158px] sm:grid-cols-1 sm:items-stretch sm:rounded-3xl sm:p-4"
          >
            <span class="row-span-3 grid h-10 w-10 place-items-center rounded-xl bg-teal-50 px-1 text-lg font-bold text-teal-800 transition-transform duration-200 group-hover:scale-105 sm:row-span-1 sm:mb-3">
              {tool.icon ?? (tool.type === 'ai' ? '✦' : '↔')}
            </span>
            <div class="flex min-w-0 items-start justify-between gap-2">
              <h3 class="m-0 line-clamp-2 text-sm font-extrabold leading-5 text-slate-950 group-hover:text-teal-800">{tool.title}</h3>
              <span class="flex shrink-0 flex-wrap justify-end gap-1">
                {index < 3 && <span class="rounded-full bg-teal-100 px-2 py-0.5 text-[9px] font-bold uppercase tracking-wide text-teal-800">New</span>}
                <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[9px] font-bold uppercase tracking-wide text-slate-600">
                  {tool.type === 'ai' ? 'AI' : 'Browser'}
                </span>
              </span>
            </div>
            <p class="m-0 line-clamp-2 text-xs leading-4 text-slate-600 sm:mt-1">{tool.description}</p>
            <div class="col-start-2 flex min-w-0 items-center justify-between gap-2 pt-1 sm:col-start-auto sm:mt-auto sm:pt-3">
              <span class="truncate text-[10px] font-semibold text-slate-500">{tool.category}</span>
              <span class="shrink-0 text-xs font-bold text-teal-800">Open <span aria-hidden="true">→</span></span>
            </div>
          </a>
        ))}
      </div>
      <p id="all-tools-empty" class="hidden rounded-2xl border border-dashed border-slate-300 py-12 text-center text-slate-600">
        No tools match your search. Try another term or category.
      </p>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .all-tool-card {
    animation: all-tool-enter 420ms both;
    animation-delay: calc(var(--card-index, 0) * 25ms);
  }

  @keyframes all-tool-enter {
    from {
      opacity: 0;
      translate: 0 8px;
    }

    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .all-tool-card {
      animation: none;
    }
  }
</style>

<script>
  const allToolsSearch = document.querySelector<HTMLInputElement>('#all-tools-search');
  const allToolsCards = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-all-tool-card]'));
  const allToolsFilters = Array.from(document.querySelectorAll<HTMLButtonElement>('.all-tools-filter'));
  const allToolsCount = document.querySelector<HTMLElement>('#all-tools-count');
  const allToolsEmpty = document.querySelector<HTMLElement>('#all-tools-empty');
  let selectedToolCategory = 'all';

  const updateAllTools = () => {
    const query = allToolsSearch?.value.trim().toLocaleLowerCase() ?? '';
    let visibleCount = 0;

    for (const card of allToolsCards) {
      const matchesCategory =
        selectedToolCategory === 'all' || card.dataset.category === selectedToolCategory;
      const matchesSearch = card.dataset.search?.toLocaleLowerCase().includes(query) ?? false;
      const visible = matchesCategory && matchesSearch;
      card.classList.toggle('hidden', !visible);
      if (visible) visibleCount += 1;
    }

    if (allToolsCount) allToolsCount.textContent = `Showing ${visibleCount} ${visibleCount === 1 ? 'tool' : 'tools'}`;
    allToolsEmpty?.classList.toggle('hidden', visibleCount > 0);
  };

  allToolsSearch?.addEventListener('input', updateAllTools);
  allToolsFilters.forEach((filter) => {
    filter.addEventListener('click', () => {
      selectedToolCategory = filter.dataset.category ?? 'all';
      allToolsFilters.forEach((item) => {
        const selected = item === filter;
        item.setAttribute('aria-pressed', String(selected));
        item.classList.toggle('bg-slate-950', selected);
        item.classList.toggle('text-white', selected);
        item.classList.toggle('border', !selected);
        item.classList.toggle('border-slate-300', !selected);
        item.classList.toggle('bg-white', !selected);
        item.classList.toggle('text-slate-700', !selected);
      });
      updateAllTools();
    });
  });
</script>
