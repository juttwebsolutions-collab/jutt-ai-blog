---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';
---

<Layout
  title="Clean JSON Prettifier & Minifier | Jutt AI Tools"
  description="Prettify, minify, and validate JSON locally in your browser. Your data is never sent to a server."
  url="/tools/json-formatter"
>
  <Navbar />
  <main class="mx-auto w-[min(900px,calc(100%-2rem))] pb-12">
    <header class="py-12 sm:py-16">
      <a href="/" class="text-sm font-bold text-teal-800 hover:text-teal-950">← All tools</a>
      <p class="mb-2 mt-7 text-xs font-extrabold uppercase tracking-[0.16em] text-teal-800">Converters &amp; Text Tools · Runs in your browser</p>
      <h1 class="text-3xl font-black tracking-tight text-slate-950 sm:text-4xl">Clean JSON Prettifier &amp; Minifier</h1>
      <p class="mt-3 max-w-2xl leading-7 text-slate-600">Format, compress, or check JSON without sending your data anywhere.</p>
    </header>

    <section class="space-y-5 rounded-3xl border border-slate-200 bg-white p-5 shadow-sm sm:p-8" aria-label="JSON formatter">
      <div>
        <label for="json-input" class="mb-2 block text-sm font-bold text-slate-900">Raw JSON</label>
        <textarea id="json-input" rows="9" spellcheck="false" placeholder='{"name":"Jutt AI","tools":["format","validate"]}' class="block w-full resize-y rounded-2xl border border-slate-300 bg-white px-4 py-4 font-mono text-sm leading-6 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-teal-600 focus:ring-4 focus:ring-teal-100"></textarea>
      </div>

      <div id="json-alert" class="hidden rounded-2xl border px-4 py-3 text-sm" role="status" aria-live="polite"></div>
      <div class="flex flex-wrap gap-2">
        <button id="prettify-json" type="button" class="rounded-full bg-slate-950 px-4 py-2.5 text-sm font-bold text-white transition hover:bg-teal-800">Prettify (Format 2-Spaces)</button>
        <button id="minify-json" type="button" class="rounded-full border border-slate-300 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 transition hover:border-teal-700 hover:text-teal-800">Minify (Single Line)</button>
        <button id="validate-json" type="button" class="rounded-full border border-slate-300 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 transition hover:border-teal-700 hover:text-teal-800">Validate JSON</button>
      </div>

      <div>
        <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
          <label for="json-output" class="text-sm font-bold text-slate-900">Output</label>
          <button id="copy-json" type="button" class="text-sm font-bold text-teal-800 hover:text-teal-950">Copy Output</button>
        </div>
        <textarea id="json-output" rows="9" spellcheck="false" readonly placeholder="Formatted or minified JSON will appear here..." class="block w-full resize-y rounded-2xl border border-slate-300 bg-slate-50 px-4 py-4 font-mono text-sm leading-6 text-slate-900 outline-none focus:border-teal-600 focus:ring-4 focus:ring-teal-100"></textarea>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  const jsonInput = document.querySelector<HTMLTextAreaElement>('#json-input');
  const jsonOutput = document.querySelector<HTMLTextAreaElement>('#json-output');
  const jsonAlert = document.querySelector<HTMLDivElement>('#json-alert');

  function showAlert(message: string, isError: boolean): void {
    if (!jsonAlert) return;
    jsonAlert.textContent = message;
    jsonAlert.className = isError
      ? 'rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800'
      : 'rounded-2xl border border-teal-200 bg-teal-50 px-4 py-3 text-sm text-teal-900';
  }

  function parseInput(): { valid: boolean; value?: unknown } {
    const value = jsonInput?.value.trim() ?? '';
    if (!value) {
      showAlert('Enter JSON to format or validate.', true);
      return { valid: false };
    }
    try {
      const parsed: unknown = JSON.parse(value);
      showAlert('Valid JSON.', false);
      return { valid: true, value: parsed };
    } catch (error) {
      const message = error instanceof Error ? error.message : 'The JSON syntax is invalid.';
      showAlert(`Invalid JSON: ${message}`, true);
      return { valid: false };
    }
  }

  function transformJson(indent: number | undefined): void {
    if (!jsonOutput) return;
    const parsed = parseInput();
    if (!parsed.valid) return;
    const formatted = JSON.stringify(parsed.value, null, indent);
    if (formatted !== undefined) jsonOutput.value = formatted;
  }

  jsonInput?.addEventListener('input', () => {
    if (!jsonAlert) return;
    const value = jsonInput.value.trim();
    if (!value) {
      jsonAlert.textContent = '';
      jsonAlert.className = 'hidden rounded-2xl border px-4 py-3 text-sm';
      return;
    }
    try {
      JSON.parse(value);
      showAlert('Valid JSON.', false);
    } catch (error) {
      const message = error instanceof Error ? error.message : 'The JSON syntax is invalid.';
      showAlert(`Invalid JSON: ${message}`, true);
    }
  });

  document.querySelector<HTMLButtonElement>('#prettify-json')?.addEventListener('click', () => transformJson(2));
  document.querySelector<HTMLButtonElement>('#minify-json')?.addEventListener('click', () => transformJson(undefined));
  document.querySelector<HTMLButtonElement>('#validate-json')?.addEventListener('click', () => {
    parseInput();
  });
  document.querySelector<HTMLButtonElement>('#copy-json')?.addEventListener('click', async () => {
    if (!jsonOutput || !jsonAlert) return;
    if (!jsonOutput.value) {
      showAlert('There is no output to copy yet.', true);
      return;
    }
    try {
      await navigator.clipboard.writeText(jsonOutput.value);
      showAlert('Output copied to clipboard.', false);
    } catch {
      showAlert('Could not access the clipboard. Please copy the output manually.', true);
    }
  });
</script>
