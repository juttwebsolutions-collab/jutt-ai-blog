---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';
---

<Layout
  title="Secure Password & API Key Generator | Jutt AI Tools"
  description="Generate strong passwords and API keys locally using your browser's cryptographic random number generator."
  url="/tools/password-generator"
>
  <Navbar />
  <main class="mx-auto w-[min(900px,calc(100%-2rem))] pb-12">
    <header class="py-12 sm:py-16">
      <a href="/" class="text-sm font-bold text-teal-800 hover:text-teal-950">← All tools</a>
      <p class="mb-2 mt-7 text-xs font-extrabold uppercase tracking-[0.16em] text-teal-800">Converters &amp; Text Tools · Runs in your browser</p>
      <h1 class="text-3xl font-black tracking-tight text-slate-950 sm:text-4xl">Secure Password &amp; API Key Generator</h1>
      <p class="mt-3 max-w-2xl leading-7 text-slate-600">Create a random password with the character groups and length you choose. Generation happens only in your browser.</p>
    </header>

    <section class="space-y-6 rounded-3xl border border-slate-200 bg-white p-5 shadow-sm sm:p-8" aria-label="Password generator">
      <div>
        <div class="mb-2 flex items-center justify-between gap-3">
          <label for="password-length" class="text-sm font-bold text-slate-900">Password length</label>
          <output id="length-value" for="password-length" class="rounded-full bg-teal-50 px-3 py-1 text-sm font-bold text-teal-900">20 characters</output>
        </div>
        <input id="password-length" type="range" min="8" max="64" value="20" class="w-full accent-teal-800" />
        <div class="mt-1 flex justify-between text-xs text-slate-500"><span>8</span><span>64</span></div>
      </div>

      <fieldset>
        <legend class="mb-3 text-sm font-bold text-slate-900">Character types</legend>
        <div class="grid gap-3 sm:grid-cols-2">
          <label class="flex items-center gap-3 rounded-xl border border-slate-200 p-3 text-sm text-slate-700"><input id="include-uppercase" type="checkbox" checked class="h-4 w-4 accent-teal-800" /> Include Uppercase (A-Z)</label>
          <label class="flex items-center gap-3 rounded-xl border border-slate-200 p-3 text-sm text-slate-700"><input id="include-lowercase" type="checkbox" checked class="h-4 w-4 accent-teal-800" /> Include Lowercase (a-z)</label>
          <label class="flex items-center gap-3 rounded-xl border border-slate-200 p-3 text-sm text-slate-700"><input id="include-numbers" type="checkbox" checked class="h-4 w-4 accent-teal-800" /> Include Numbers (0-9)</label>
          <label class="flex items-center gap-3 rounded-xl border border-slate-200 p-3 text-sm text-slate-700"><input id="include-symbols" type="checkbox" class="h-4 w-4 accent-teal-800" /> Include Symbols (!@#$%^&amp;*)</label>
        </div>
      </fieldset>

      <div class="rounded-2xl bg-slate-50 p-4 sm:p-5">
        <div class="mb-2 flex items-center justify-between gap-3">
          <span class="text-sm font-bold text-slate-900">Password strength</span>
          <span id="strength-label" class="text-sm font-extrabold text-teal-800" aria-live="polite">—</span>
        </div>
        <div class="h-2 overflow-hidden rounded-full bg-slate-200" role="meter" aria-label="Password strength" aria-valuemin="0" aria-valuemax="4" aria-valuenow="0">
          <div id="strength-bar" class="h-full w-0 rounded-full bg-teal-600 transition-all"></div>
        </div>
      </div>

      <div>
        <label for="generated-password" class="mb-2 block text-sm font-bold text-slate-900">Generated password</label>
        <textarea id="generated-password" rows="2" readonly spellcheck="false" class="block w-full resize-y rounded-2xl border border-slate-300 bg-slate-50 px-4 py-4 font-mono text-lg leading-7 text-slate-900 outline-none focus:border-teal-600 focus:ring-4 focus:ring-teal-100"></textarea>
      </div>

      <div class="flex flex-wrap gap-3">
        <button id="generate-password" type="button" class="rounded-full bg-slate-950 px-5 py-3 text-sm font-bold text-white transition hover:bg-teal-800">Generate New</button>
        <button id="copy-password" type="button" class="rounded-full border border-slate-300 bg-white px-5 py-3 text-sm font-bold text-slate-700 transition hover:border-teal-700 hover:text-teal-800">Copy to Clipboard</button>
      </div>
      <p id="password-status" class="m-0 min-h-6 text-sm text-slate-600" aria-live="polite"></p>
      <p class="m-0 text-xs leading-5 text-slate-500">Uses the browser’s Web Crypto random number generator. Save generated credentials in a trusted password manager.</p>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  const lengthSlider = document.querySelector<HTMLInputElement>('#password-length');
  const lengthValue = document.querySelector<HTMLOutputElement>('#length-value');
  const generatedPassword = document.querySelector<HTMLTextAreaElement>('#generated-password');
  const strengthLabel = document.querySelector<HTMLElement>('#strength-label');
  const strengthBar = document.querySelector<HTMLDivElement>('#strength-bar');
  const strengthMeter = document.querySelector<HTMLDivElement>('[role="meter"]');
  const passwordStatus = document.querySelector<HTMLElement>('#password-status');

  const characterGroups = [
    { selector: '#include-uppercase', value: 'ABCDEFGHIJKLMNOPQRSTUVWXYZ' },
    { selector: '#include-lowercase', value: 'abcdefghijklmnopqrstuvwxyz' },
    { selector: '#include-numbers', value: '0123456789' },
    { selector: '#include-symbols', value: '!@#$%^&*' },
  ];

  function selectedGroups(): string[] {
    return characterGroups
      .filter(({ selector }) => document.querySelector<HTMLInputElement>(selector)?.checked)
      .map(({ value }) => value);
  }

  function randomIndex(max: number): number {
    const limit = Math.floor(256 / max) * max;
    const random = new Uint8Array(1);
    do {
      window.crypto.getRandomValues(random);
    } while (random[0] >= limit);
    return random[0] % max;
  }

  function updateStrength(): void {
    if (!lengthSlider || !strengthLabel || !strengthBar || !strengthMeter || !lengthValue) return;
    const length = Number(lengthSlider.value);
    const groups = selectedGroups();
    lengthValue.value = `${length} characters`;
    lengthValue.textContent = `${length} characters`;

    if (groups.length === 0) {
      strengthLabel.textContent = 'Choose a character type';
      strengthLabel.className = 'text-sm font-extrabold text-red-700';
      strengthBar.style.width = '0%';
      strengthMeter.setAttribute('aria-valuenow', '0');
      return;
    }

    const poolSize = groups.reduce((size, group) => size + group.length, 0);
    const entropy = length * Math.log2(poolSize);
    const strength = entropy < 40 ? 1 : entropy < 60 ? 2 : entropy < 80 ? 3 : 4;
    const labels = ['Weak', 'Medium', 'Strong', 'Ultra'];
    const widths = ['25%', '50%', '75%', '100%'];
    const colors = ['bg-red-500', 'bg-amber-500', 'bg-teal-500', 'bg-teal-700'];
    strengthLabel.textContent = labels[strength - 1];
    strengthLabel.className = `text-sm font-extrabold ${strength === 1 ? 'text-red-700' : strength === 2 ? 'text-amber-700' : 'text-teal-800'}`;
    strengthBar.className = `h-full rounded-full transition-all ${colors[strength - 1]}`;
    strengthBar.style.width = widths[strength - 1];
    strengthMeter.setAttribute('aria-valuenow', String(strength));
  }

  function generatePassword(): void {
    if (!lengthSlider || !generatedPassword || !passwordStatus) return;
    const groups = selectedGroups();
    if (groups.length === 0) {
      passwordStatus.textContent = 'Select at least one character type to generate a password.';
      generatedPassword.value = '';
      return;
    }

    try {
      const pool = groups.join('');
      const length = Number(lengthSlider.value);
      const characters = groups.map((group) => group[randomIndex(group.length)]);
      while (characters.length < length) characters.push(pool[randomIndex(pool.length)]);
      for (let index = characters.length - 1; index > 0; index -= 1) {
        const swapIndex = randomIndex(index + 1);
        [characters[index], characters[swapIndex]] = [characters[swapIndex], characters[index]];
      }
      generatedPassword.value = characters.join('');
      passwordStatus.textContent = '';
    } catch {
      passwordStatus.textContent = 'Secure randomness is unavailable in this browser context. Try a secure context such as HTTPS.';
      generatedPassword.value = '';
    }
    updateStrength();
  }

  lengthSlider?.addEventListener('input', () => {
    updateStrength();
    generatePassword();
  });
  characterGroups.forEach(({ selector }) => {
    document.querySelector<HTMLInputElement>(selector)?.addEventListener('change', () => {
      updateStrength();
      generatePassword();
    });
  });
  document.querySelector<HTMLButtonElement>('#generate-password')?.addEventListener('click', generatePassword);
  document.querySelector<HTMLButtonElement>('#copy-password')?.addEventListener('click', async () => {
    if (!generatedPassword || !passwordStatus) return;
    if (!generatedPassword.value) {
      passwordStatus.textContent = 'Generate a password before copying.';
      return;
    }
    try {
      await navigator.clipboard.writeText(generatedPassword.value);
      passwordStatus.textContent = 'Password copied to clipboard.';
    } catch {
      passwordStatus.textContent = 'Could not access the clipboard. Please copy the password manually.';
    }
  });

  updateStrength();
  generatePassword();
</script>
