---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';

export const prerender = true;
---

<Layout
  title="Text Case & URL Slug Converter | Jutt AI Tools"
  description="Count words, characters, and reading time; convert text case; and create URL-friendly slugs locally in your browser."
  url="/tools/text-formatter"
>
  <Navbar />
  <main class="mx-auto w-[min(900px,calc(100%-2rem))] pb-12">
    <header class="py-12 sm:py-16">
      <a href="/" class="text-sm font-bold text-teal-800 hover:text-teal-950">← All tools</a>
      <p class="mb-2 mt-7 text-xs font-extrabold uppercase tracking-[0.16em] text-teal-800">Converters &amp; Text Tools · Runs in your browser</p>
      <h1 class="text-3xl font-black tracking-tight text-slate-950 sm:text-4xl">Text Case &amp; URL Slug Converter</h1>
      <p class="mt-3 max-w-2xl leading-7 text-slate-600">Analyze text, change its case, or create a clean URL slug. Your text stays in this browser.</p>
    </header>

    <section class="space-y-6 rounded-3xl border border-slate-200 bg-white p-5 shadow-sm sm:p-8" aria-label="Text formatter">
      <label for="source-text" class="block text-sm font-bold text-slate-900">Your text</label>
      <textarea
        id="source-text"
        rows="7"
        placeholder="Paste or type text to analyze and convert..."
        class="block w-full resize-y rounded-2xl border border-slate-300 bg-white px-4 py-4 text-base leading-7 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-teal-600 focus:ring-4 focus:ring-teal-100"
      ></textarea>

      <dl class="grid grid-cols-1 gap-3 sm:grid-cols-3">
        <div class="rounded-2xl bg-slate-50 p-4"><dt class="text-sm text-slate-500">Words</dt><dd id="word-count" class="mt-1 text-2xl font-black text-slate-950">0</dd></div>
        <div class="rounded-2xl bg-slate-50 p-4"><dt class="text-sm text-slate-500">Characters</dt><dd id="character-count" class="mt-1 text-2xl font-black text-slate-950">0</dd></div>
        <div class="rounded-2xl bg-slate-50 p-4"><dt class="text-sm text-slate-500">Reading time</dt><dd id="reading-time" class="mt-1 text-2xl font-black text-slate-950">0 min</dd></div>
      </dl>

      <div>
        <p class="mb-3 text-sm font-bold text-slate-900">Transform case</p>
        <div class="flex flex-wrap gap-2">
          <button type="button" data-case="upper" class="rounded-full bg-slate-950 px-4 py-2 text-sm font-bold text-white transition hover:bg-teal-800">UPPERCASE</button>
          <button type="button" data-case="lower" class="rounded-full border border-slate-300 bg-white px-4 py-2 text-sm font-bold text-slate-700 transition hover:border-teal-700 hover:text-teal-800">lowercase</button>
          <button type="button" data-case="title" class="rounded-full border border-slate-300 bg-white px-4 py-2 text-sm font-bold text-slate-700 transition hover:border-teal-700 hover:text-teal-800">Title Case</button>
        </div>
      </div>

      <div>
        <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
          <label for="transformed-text" class="text-sm font-bold text-slate-900">Converted text</label>
          <button id="copy-text" type="button" class="text-sm font-bold text-teal-800 hover:text-teal-950">Copy text</button>
        </div>
        <textarea id="transformed-text" rows="4" placeholder="Choose a case transformation above..." class="block w-full resize-y rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 leading-7 text-slate-900 outline-none focus:border-teal-600 focus:ring-4 focus:ring-teal-100"></textarea>
      </div>

      <div>
        <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
          <label for="slug-output" class="text-sm font-bold text-slate-900">URL slug</label>
          <button id="copy-slug" type="button" class="text-sm font-bold text-teal-800 hover:text-teal-950">Copy slug</button>
        </div>
        <input id="slug-output" type="text" readonly class="block w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-slate-900 outline-none focus:border-teal-600 focus:ring-4 focus:ring-teal-100" />
      </div>
      <p id="copy-status" class="m-0 min-h-6 text-sm text-slate-600" aria-live="polite"></p>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  const source = document.querySelector<HTMLTextAreaElement>('#source-text');
  const wordCount = document.querySelector<HTMLElement>('#word-count');
  const characterCount = document.querySelector<HTMLElement>('#character-count');
  const readingTime = document.querySelector<HTMLElement>('#reading-time');
  const transformed = document.querySelector<HTMLTextAreaElement>('#transformed-text');
  const slugOutput = document.querySelector<HTMLInputElement>('#slug-output');
  const copyStatus = document.querySelector<HTMLElement>('#copy-status');

  function toSlug(value: string): string {
    return value
      .normalize('NFKD')
      .replace(/\p{Diacritic}/gu, '')
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '');
  }

  function updateTextStats(): void {
    if (!source || !wordCount || !characterCount || !readingTime || !slugOutput) return;
    const text = source.value;
    const words = text.trim() ? text.trim().split(/\s+/).length : 0;
    wordCount.textContent = String(words);
    characterCount.textContent = String(text.length);
    readingTime.textContent = words === 0 ? '0 min' : `${Math.max(1, Math.ceil(words / 200))} min`;
    slugOutput.value = toSlug(text);
  }

  async function copyValue(value: string): Promise<void> {
    if (!copyStatus) return;
    if (!value) {
      copyStatus.textContent = 'There is nothing to copy yet.';
      return;
    }
    try {
      await navigator.clipboard.writeText(value);
      copyStatus.textContent = 'Copied to clipboard.';
    } catch {
      copyStatus.textContent = 'Could not access the clipboard. Please copy the text manually.';
    }
  }

  source?.addEventListener('input', updateTextStats);
  document.querySelectorAll<HTMLButtonElement>('[data-case]').forEach((button) => {
    button.addEventListener('click', () => {
      if (!source || !transformed) return;
      const { case: caseType } = button.dataset;
      const value = source.value;
      if (caseType === 'upper') transformed.value = value.toLocaleUpperCase();
      if (caseType === 'lower') transformed.value = value.toLocaleLowerCase();
      if (caseType === 'title') {
        transformed.value = value
          .toLocaleLowerCase()
          .replace(/(^|[\s([{'"“‘-])(\p{L})/gu, (_match, separator: string, letter: string) => separator + letter.toLocaleUpperCase());
      }
      if (copyStatus) copyStatus.textContent = '';
    });
  });
  document.querySelector<HTMLButtonElement>('#copy-text')?.addEventListener('click', () => {
    void copyValue(transformed?.value ?? '');
  });
  document.querySelector<HTMLButtonElement>('#copy-slug')?.addEventListener('click', () => {
    void copyValue(slugOutput?.value ?? '');
  });
  updateTextStats();
</script>
