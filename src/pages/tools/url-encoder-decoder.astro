---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';
---

<Layout
  title="URL Encoder / Decoder | Jutt AI Tools"
  description="Encode or decode URL components with encodeURIComponent and decodeURIComponent in your browser. Copy the result in one click."
  url="/tools/url-encoder-decoder"
>
  <Navbar />
  <main class="mx-auto w-[min(1000px,calc(100%-2rem))] pb-12">
    <header class="py-12 sm:py-16">
      <a href="/tools" class="text-sm font-bold text-teal-800 hover:text-teal-950">← All tools</a>
      <p class="mb-2 mt-7 text-xs font-extrabold uppercase tracking-[0.16em] text-teal-800">Design &amp; developer tools · Runs in your browser</p>
      <h1 class="text-3xl font-black tracking-tight text-slate-950 sm:text-4xl">URL Encoder / Decoder</h1>
      <p class="mt-3 max-w-2xl leading-7 text-slate-600">Encode special characters for use in a URL component or decode an encoded value. Processing stays in your browser.</p>
    </header>

    <section class="space-y-5 rounded-3xl border border-slate-200 bg-white/90 p-5 shadow-sm backdrop-blur-md sm:p-8" aria-label="URL encoder and decoder">
      <div>
        <label for="url-input" class="mb-2 block text-sm font-bold text-slate-900">Input text</label>
        <textarea id="url-input" rows="7" spellcheck="false" placeholder="Enter text or a URL component..." class="block w-full resize-y rounded-2xl border border-slate-300 bg-white px-4 py-4 font-mono text-sm leading-6 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-teal-600 focus:ring-4 focus:ring-teal-100"></textarea>
      </div>
      <div class="flex flex-wrap gap-2">
        <button id="encode-url" type="button" class="rounded-full bg-slate-950 px-5 py-2.5 text-sm font-bold text-white transition hover:bg-teal-800">Encode component</button>
        <button id="decode-url" type="button" class="rounded-full border border-slate-300 bg-white px-5 py-2.5 text-sm font-bold text-slate-700 transition hover:border-teal-700 hover:text-teal-800">Decode component</button>
      </div>
      <div id="url-status" class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700" role="status" aria-live="polite">Enter a value and choose an action.</div>
      <div>
        <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
          <label for="url-output" class="text-sm font-bold text-slate-900">Output</label>
          <button id="copy-url" type="button" class="rounded-full border border-slate-300 bg-white px-4 py-2 text-sm font-bold text-slate-700 transition hover:border-teal-700 hover:text-teal-800">Copy to Clipboard</button>
        </div>
        <textarea id="url-output" rows="7" spellcheck="false" readonly placeholder="Encoded or decoded result will appear here..." class="block w-full resize-y rounded-2xl border border-slate-300 bg-slate-50 px-4 py-4 font-mono text-sm leading-6 text-slate-900 outline-none"></textarea>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  const urlInput = document.querySelector<HTMLTextAreaElement>('#url-input');
  const urlOutput = document.querySelector<HTMLTextAreaElement>('#url-output');
  const urlStatus = document.querySelector<HTMLDivElement>('#url-status');

  function showUrlStatus(message: string, isError = false): void {
    if (!urlStatus) return;
    urlStatus.textContent = message;
    urlStatus.className = isError
      ? 'rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800'
      : 'rounded-2xl border border-teal-200 bg-teal-50 px-4 py-3 text-sm text-teal-900';
  }

  function transformUrl(mode: 'encode' | 'decode'): void {
    if (!urlInput || !urlOutput) return;
    try {
      urlOutput.value = mode === 'encode'
        ? encodeURIComponent(urlInput.value)
        : decodeURIComponent(urlInput.value);
      showUrlStatus(mode === 'encode' ? 'URL component encoded.' : 'URL component decoded.');
    } catch {
      urlOutput.value = '';
      showUrlStatus('Unable to decode this value. Check that the percent-encoding is valid.', true);
    }
  }

  document.querySelector<HTMLButtonElement>('#encode-url')?.addEventListener('click', () => transformUrl('encode'));
  document.querySelector<HTMLButtonElement>('#decode-url')?.addEventListener('click', () => transformUrl('decode'));
  document.querySelector<HTMLButtonElement>('#copy-url')?.addEventListener('click', async () => {
    if (!urlOutput) return;
    if (!urlOutput.value) {
      showUrlStatus('There is no output to copy yet.', true);
      return;
    }
    try {
      await navigator.clipboard.writeText(urlOutput.value);
      showUrlStatus('Output copied to clipboard.');
    } catch {
      showUrlStatus('Could not access the clipboard. Please copy the output manually.', true);
    }
  });
</script>
